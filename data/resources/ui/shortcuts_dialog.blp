using Gtk 4.0;
using Adw 1;
// Keep in sync with GatefoldApplication::setup_accels (application.rs).
Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("Search");
      accelerator: "<Control>f";
    }

    Adw.ShortcutsItem {
      title: _("Preferences");
      accelerator: "<Control>comma";
    }

    Adw.ShortcutsItem {
      title: _("Keyboard Shortcuts");
      accelerator: "<Control>question";
    }

    Adw.ShortcutsItem {
      title: _("Close Window");
      accelerator: "<Control>w";
    }

    Adw.ShortcutsItem {
      title: _("Quit");
      accelerator: "<Control>q";
    }
  }

  Adw.ShortcutsSection {
    title: _("Library");

    Adw.ShortcutsItem {
      title: _("Albums");
      accelerator: "<Control>1";
    }

    Adw.ShortcutsItem {
      title: _("Artists");
      accelerator: "<Control>2";
    }

    Adw.ShortcutsItem {
      title: _("Playlists");
      accelerator: "<Control>3";
    }
  }

  Adw.ShortcutsSection {
    title: _("Playback");

    Adw.ShortcutsItem {
      title: _("Play or Pause");
      accelerator: "space";
    }

    Adw.ShortcutsItem {
      title: _("Previous Song");
      accelerator: "<Control>Left";
    }

    Adw.ShortcutsItem {
      title: _("Next Song");
      accelerator: "<Control>Right";
    }

    Adw.ShortcutsItem {
      title: _("Show Lyrics");
      accelerator: "<Control>l";
    }

    Adw.ShortcutsItem {
      title: _("Show Queue");
      accelerator: "<Control>u";
    }
  }
}
