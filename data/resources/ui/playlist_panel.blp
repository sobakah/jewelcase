using Gtk 4.0;
using Adw 1;
// A playlist in the side panel (CONCEPT.md §4.1): editable order (drag
// and drop), remove, rename, cover, export.
template $GatefoldPlaylistPanel: Adw.Bin {
  styles [
    "album-panel",
  ]

  // A grip on the left edge, like the one on top of the player, closes
  // the panel (CONCEPT.md §4.1).
  child: Gtk.Overlay {
    // The cover, blurred, behind the top of the panel (like the player).
    child: $GatefoldCoverBackdrop backdrop {
      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          show-title: false;
          show-start-title-buttons: false;
          show-end-title-buttons: false;

          styles [
            "flat",
          ]
        }

        content: Gtk.ScrolledWindow {
          hscrollbar-policy: never;

          child: Adw.Clamp {
            styles [
              "bottom-room",
            ]

            maximum-size: 560;
            margin-start: 18;
            margin-end: 18;
            margin-bottom: 24;

            child: Gtk.Box {
              orientation: vertical;
              spacing: 6;

              Adw.Clamp {
                maximum-size: 360;
                margin-bottom: 12;

                child: $GatefoldCoverImage cover {
                  min-size: 160;
                  natural-size: 360;
                  kind: "panel";
                };
              }

              // The name wraps (a long one mustn't widen the panel); click it
              // to rename: the text field shows, Enter or clicking away saves,
              // Escape cancels.
              Gtk.Stack name_stack {
                hhomogeneous: false;
                vhomogeneous: false;
                interpolate-size: true;

                Gtk.StackPage {
                  name: "label";

                  child: Gtk.Label name {
                    wrap: true;
                    wrap-mode: word_char;
                    xalign: 0;
                    width-chars: 1;
                    max-width-chars: 1;
                    hexpand: true;
                    tooltip-text: _("Rename");

                    styles [
                      "title-2",
                      "playlist-name",
                    ]
                  };
                }

                Gtk.StackPage {
                  name: "entry";

                  child: Gtk.Entry name_entry {
                    width-chars: 1;
                    hexpand: true;

                    styles [
                      "title-2",
                    ]
                  };
                }
              }

              Gtk.Label meta {
                wrap: true;
                xalign: 0;

                styles [
                  "dim-label",
                  "caption",
                ]
              }

              Gtk.Label availability {
                wrap: true;
                xalign: 0;
                visible: false;

                styles [
                  "caption",
                ]
              }

              // Spotify playlists (CONCEPT.md §9.5): whose, and changes not
              // sent yet.
              Gtk.Label source {
                wrap: true;
                xalign: 0;
                visible: false;

                styles [
                  "dim-label",
                  "caption",
                ]
              }

              Gtk.Box {
                spacing: 6;
                margin-top: 12;
                margin-bottom: 12;

                Gtk.Button {
                  action-name: "playlist.play";

                  child: Adw.ButtonContent {
                    icon-name: "media-playback-start-symbolic";
                    label: _("_Play");
                    use-underline: true;
                  };

                  styles [
                    "pill",
                    "suggested-action",
                  ]
                }

                Gtk.Button {
                  icon-name: "media-playlist-shuffle-symbolic";
                  accessibility {
                    label: _("Shuffle");
                  }

                  action-name: "playlist.shuffle";
                  valign: center;

                  styles [
                    "circular",
                  ]
                }

                // Sorted like on Spotify; only the view, remembered per
                // playlist (else Preferences' default).
                Gtk.MenuButton {
                  icon-name: "view-sort-descending-symbolic";
                  tooltip-text: _("Sort");
                  menu-model: sort_menu;
                  valign: center;

                  styles [
                    "circular",
                  ]
                }

                Gtk.MenuButton {
                  icon-name: "view-more-symbolic";
                  accessibility {
                    label: _("More");
                  }

                  menu-model: playlist_menu;
                  valign: center;

                  styles [
                    "circular",
                  ]
                }
              }

              // Find songs in the library and add them right here.
              Gtk.SearchEntry add_search {
                placeholder-text: _("Add Songs…");
                margin-bottom: 6;
              }

              Gtk.ListBox add_results {
                selection-mode: none;
                visible: false;
                margin-bottom: 12;

                styles [
                  "boxed-list",
                ]
              }

              Adw.StatusPage hidden {
                icon-name: "gatefold-spotify-symbolic";
                title: _("Spotify Doesn’t Show These Songs");
                description: _("Spotify only shows the songs of playlists you own or collaborate on to apps like Gatefold. With Soloist, Play starts it there.");
                visible: false;

                child: Gtk.Button {
                  label: _("_Open in Spotify");
                  use-underline: true;
                  action-name: "playlist.open-spotify";
                  halign: center;

                  styles [
                    "pill",
                  ]
                };

                styles [
                  "compact",
                ]
              }

              Adw.StatusPage empty {
                icon-name: "view-list-bullet-symbolic";
                title: _("Empty Playlist");
                description: _("Search above to add songs, or use “Add to Playlist…” on an album or song.");
                visible: false;

                styles [
                  "compact",
                ]
              }

              // Reordering a Spotify playlist (CONCEPT.md §9.6): only after
              // choosing it in the menu; the new order goes out once done.
              Adw.Banner arrange_banner {
                title: _("Drag songs to change the order, here and on Spotify");
                button-label: _("_Done");
                revealed: false;
                margin-bottom: 6;
              }

              Gtk.ListBox items {
                selection-mode: none;

                styles [
                  "boxed-list",
                  "reorderable",
                ]
              }
            };
          };
        };
      };
    };

    [overlay]
    Gtk.Button {
      action-name: "playlist.close";
      halign: start;
      valign: center;

      accessibility {
        label: _("Close");
      }

      child: Gtk.Box {
        halign: center;
        valign: center;

        styles [
          "grip",
        ]
      };

      styles [
        "panel-close-handle",
      ]
    }
  };
}

menu sort_menu {
  section {
    item {
      label: _("_Custom Order");
      action: "sort.by";
      target: "custom";
    }

    item {
      label: _("_Title");
      action: "sort.by";
      target: "title";
    }

    item {
      label: _("_Artist");
      action: "sort.by";
      target: "artist";
    }

    item {
      label: _("A_lbum");
      action: "sort.by";
      target: "album";
    }

    item {
      label: _("_Date Added");
      action: "sort.by";
      target: "added";
    }

    item {
      label: _("D_uration");
      action: "sort.by";
      target: "duration";
    }
  }

  section {
    item {
      label: _("_Reverse Order");
      action: "sort.reversed";
    }
  }

  section {
    item {
      label: _("Use _Default Sort");
      action: "sort.default";
    }
  }
}

menu playlist_menu {
  section {
    item {
      label: _("Play _Next");
      action: "playlist.play-next";
    }

    item {
      label: _("_Add to Queue");
      action: "playlist.add-to-queue";
    }

    item {
      label: _("Add to _Playlist…");
      action: "playlist.add-to-playlist";
    }
  }

  section {
    item {
      label: _("_Rename…");
      action: "playlist.rename";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Change _Cover…");
      action: "playlist.change-cover";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Use _Automatic Cover");
      action: "playlist.reset-cover";
      hidden-when: "action-disabled";
    }
  }

  // Spotify (CONCEPT.md §9.6).
  section {
    item {
      label: _("Re_name on Spotify…");
      action: "playlist.rename-spotify";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Change Or_der on Spotify");
      action: "playlist.arrange";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Create on _Spotify…");
      action: "playlist.publish";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Re_fresh from Spotify");
      action: "playlist.refresh";
      hidden-when: "action-disabled";
    }

    item {
      label: _("_Open in Spotify");
      action: "playlist.open-spotify";
      hidden-when: "action-disabled";
    }

    item {
      label: _("_Duplicate as Local Playlist");
      action: "playlist.duplicate";
      hidden-when: "action-disabled";
    }

    item {
      label: _("_Stop Syncing with Spotify…");
      action: "playlist.unlink";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Remo_ve from Spotify…");
      action: "playlist.remove-spotify";
      hidden-when: "action-disabled";
    }
  }

  section {
    item {
      label: _("_Export…");
      action: "playlist.export";
    }

    item {
      label: _("_Delete Playlist…");
      action: "playlist.delete";
      hidden-when: "action-disabled";
    }
  }
}
