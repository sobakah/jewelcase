using Gtk 4.0;
using Adw 1;
// The album detail side panel (CONCEPT.md §4.1).
template $GatefoldAlbumPanel: Adw.Bin {
  styles [
    "album-panel",
  ]

  // The cover, blurred, behind the top of the panel (like the player).
  child: $GatefoldCoverBackdrop backdrop {
    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        show-title: false;
        show-start-title-buttons: false;
        show-end-title-buttons: false;

        [end]
        Gtk.Button {
          icon-name: "window-close-symbolic";
          tooltip-text: _("Close");
          action-name: "panel.close";
        }

        styles [
          "flat",
        ]
      }

      content: Gtk.ScrolledWindow {
        hscrollbar-policy: never;

        child: Adw.Clamp {
          styles [
            "bottom-room",
          ]

          maximum-size: 560;
          margin-start: 18;
          margin-end: 18;
          margin-bottom: 24;

          child: Gtk.Box {
            orientation: vertical;
            spacing: 6;

            Adw.Clamp {
              maximum-size: 360;
              margin-bottom: 12;

              child: $GatefoldCoverImage cover {
                min-size: 160;
                natural-size: 360;
                kind: "panel";
              };
            }

            Gtk.Label title {
              wrap: true;
              xalign: 0;
              selectable: true;

              styles [
                "title-2",
              ]
            }

            Gtk.Label edition {
              wrap: true;
              xalign: 0;
              visible: false;

              styles [
                "dim-label",
              ]
            }

            // Album artists as links to their pages, or the plain credit.
            Adw.WrapBox artists {
              child-spacing: 12;
            }

            Gtk.Label meta {
              wrap: true;
              xalign: 0;

              styles [
                "dim-label",
                "caption",
              ]
            }

            Gtk.Box {
              spacing: 6;
              margin-top: 12;
              margin-bottom: 12;

              Gtk.Button {
                action-name: "panel.play";

                child: Adw.ButtonContent {
                  icon-name: "media-playback-start-symbolic";
                  label: _("_Play");
                  use-underline: true;
                };

                styles [
                  "pill",
                  "suggested-action",
                ]
              }

              Gtk.Button {
                icon-name: "media-playlist-shuffle-symbolic";
                tooltip-text: _("Shuffle");
                action-name: "panel.shuffle";
                valign: center;

                styles [
                  "circular",
                ]
              }

              Gtk.MenuButton {
                icon-name: "view-more-symbolic";
                tooltip-text: _("More");
                menu-model: album_menu;
                valign: center;

                styles [
                  "circular",
                ]
              }
            }

            Gtk.Box tracks {
              orientation: vertical;
              spacing: 12;
            }

            Gtk.Box versions_box {
              spacing: 12;
              margin-top: 12;
              visible: false;

              Gtk.Label versions_label {
                hexpand: true;
                wrap: true;
                xalign: 0;

                styles [
                  "dim-label",
                  "caption",
                ]
              }

              Gtk.DropDown versions {
                valign: center;
                tooltip-text: _("Version to Play");
              }
            }
          };
        };
      };
    };
  };
}

menu album_menu {
  section {
    item {
      label: _("Play _Next");
      action: "panel.play-next";
    }

    item {
      label: _("_Add to Queue");
      action: "panel.add-to-queue";
    }

    item {
      label: _("Add to _Playlist…");
      action: "panel.add-to-playlist";
    }
  }

  section {
    item {
      label: _("_Edit Tags…");
      action: "panel.edit-tags";
      hidden-when: "action-disabled";
    }

    item {
      label: _("C_hange Cover…");
      action: "panel.edit-tags";
      hidden-when: "action-disabled";
    }

    // Spotify albums (CONCEPT.md §9.8).
    item {
      label: _("_Open in Spotify");
      action: "panel.open-spotify";
      hidden-when: "action-disabled";
    }
  }

  section {
    item {
      label: _("_Find Missing Lyrics");
      action: "panel.find-lyrics";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Check _Lyrics in lyrembed…");
      action: "panel.lyrembed";
      hidden-when: "action-disabled";
    }
  }
}
