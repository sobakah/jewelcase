using Gtk 4.0;
using Adw 1;

template $GatefoldPreferencesDialog: Adw.PreferencesDialog {
  Adw.PreferencesPage {
    name: "library";
    title: _("Library");
    icon-name: "folder-music-symbolic";
    // Rows are added from preferences_dialog.rs.
    Adw.PreferencesGroup folders_group {
      title: _("Music Folders");
      description: _(
        "Gatefold reads music from these folders. Symlinked folders and folders inside another music folder can't be added."
      );

      header-suffix: Gtk.Button {
        valign: center;
        action-name: "prefs.add-folder";

        child: Adw.ButtonContent {
          icon-name: "list-add-symbolic";
          label: _("_Add");
          use-underline: true;
        };

        styles [
          "flat",
        ]
      };
    }

    Adw.PreferencesGroup {
      title: _("Start");

      Adw.ComboRow start_view_row {
        title: _("_Open With");
        subtitle: _("The view shown when Gatefold starts");
        use-underline: true;

        model: Gtk.StringList {
          strings [
            _("Last Used View"),
            _("Albums"),
            _("Artists"),
            _("Playlists"),
          ]
        };
      }
    }

    // Smart shuffle's analysis (CONCEPT.md §7), filled in from
    // preferences_dialog.rs.
    Adw.PreferencesGroup {
      title: _("Song Analysis");
      description: _(
        "Tempo and sound of each song, for “Mix In Similar Songs” and “Keep Playing”. In the background it runs at low priority and waits while on battery; as fast as possible uses several cores, then continues in the background for new songs."
      );

      Adw.ComboRow analysis_row {
        title: _("_Analyze Songs");
        use-underline: true;

        model: Gtk.StringList {
          strings [
            _("Off"),
            _("In the Background"),
            _("Now, as Fast as Possible"),
          ]
        };
      }

      Adw.ActionRow analysis_progress_row {
        title: _("Progress");

        [suffix]
        Gtk.ProgressBar analysis_bar {
          valign: center;
          width-request: 120;
        }

        [suffix]
        Gtk.Button analysis_pause {
          valign: center;
          icon-name: "media-playback-pause-symbolic";
          tooltip-text: _("Pause");

          styles [
            "flat",
            "circular",
          ]
        }
      }
    }
  }

  Adw.PreferencesPage {
    name: "playback";
    title: _("Playback");
    icon-name: "media-playback-start-symbolic";

    Adw.PreferencesGroup {
      title: _("Volume");

      Adw.ComboRow replaygain_row {
        title: _("_ReplayGain");
        subtitle: _("Evens out loudness using the volume tags in your files; Off plays them as they are");
        use-underline: true;

        model: Gtk.StringList {
          strings [
            _("Off"),
            _("Automatic"),
            _("Track"),
            _("Album"),
          ]
        };
      }

      Adw.SpinRow preamp_row {
        title: _("_Pre-Amp");
        subtitle: _("In dB on top of ReplayGain’s standard level; +4 is about as loud as Spotify and most players");
        use-underline: true;
        digits: 1;

        adjustment: Gtk.Adjustment {
          lower: -15;
          upper: 15;
          step-increment: 0.5;
          page-increment: 3;
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Crossfade");
      description: _("Songs fade into each other instead of following gaplessly. Only between your files, not Spotify songs.");

      Adw.SpinRow crossfade_row {
        title: _("_Crossfade");
        subtitle: _("The longest fade, in seconds; 0 is off");
        use-underline: true;

        adjustment: Gtk.Adjustment {
          lower: 0;
          upper: 12;
          step-increment: 1;
          page-increment: 3;
        };
      }

      Adw.SwitchRow crossfade_smart_row {
        title: _("_Smart Crossfade");
        subtitle: _("Fades where a song gets quiet and skips silence at the next song’s start; uses the song analysis (Library page)");
        use-underline: true;
      }

      Adw.SwitchRow crossfade_albums_row {
        title: _("Also Within _Albums");
        subtitle: _("Off: an album playing in order stays gapless");
        use-underline: true;
      }
    }

    // Whether the player opens with its side panes (CONCEPT.md §4.3).
    Adw.PreferencesGroup {
      title: _("Player");

      Adw.ComboRow lyrics_pane_row {
        title: _("_Lyrics Pane");
        subtitle: _("Shown when the player opens");
        use-underline: true;

        model: Gtk.StringList {
          strings [
            _("As Last Left"),
            _("Shown"),
            _("Hidden"),
          ]
        };
      }

      Adw.ComboRow queue_pane_row {
        title: _("Queue _Pane");
        subtitle: _("Shown when the player opens");
        use-underline: true;

        model: Gtk.StringList {
          strings [
            _("As Last Left"),
            _("Shown"),
            _("Hidden"),
          ]
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Lyrics");

      Adw.ComboRow lyrics_layout_row {
        title: _("_Romanized Lyrics");
        subtitle: _("For lyrics with an original and a romanized line");
        use-underline: true;

        model: Gtk.StringList {
          strings [
            _("Original on Top"),
            _("Romanization on Top"),
            _("Original Only"),
          ]
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Queue");

      Adw.SwitchRow restore_queue_row {
        title: _("Restore _Queue on Start");
        subtitle: _("Reopen the last queue, paused where it stopped");
        use-underline: true;
      }
    }
  }

  Adw.PreferencesPage {
    name: "online";
    title: _("Online");
    icon-name: "network-workgroup-symbolic";

    Adw.PreferencesGroup {
      title: _("Artist Information");
      description: _(
        "Photos, links and short biographies of album artists. Only artist names and MusicBrainz IDs are sent."
      );

      Adw.SwitchRow online_row {
        title: _("_Look Up Artists Online");
        subtitle: _("MusicBrainz identifies artists and finds their links");
        use-underline: true;
      }

      Adw.SwitchRow wikidata_row {
        title: _("_Wikidata and Wikipedia");
        subtitle: _("Spotify and Wikipedia links, a short biography and a photo from Wikimedia Commons");
        use-underline: true;
        sensitive: bind online_row.active;
      }

      Adw.SwitchRow fanart_row {
        title: _("_fanart.tv");
        subtitle: _("Artist photos; needs a free API key from fanart.tv");
        use-underline: true;
        sensitive: bind online_row.active;
      }

      Adw.PasswordEntryRow fanart_key_row {
        title: _("fanart.tv API _Key");
        use-underline: true;
        sensitive: bind fanart_row.active;
      }
    }

    Adw.PreferencesGroup {
      title: _("Links");

      Adw.SwitchRow spotify_app_row {
        title: _("Open Spotify Links in the _App");
        subtitle: _(
          "Otherwise they open in the browser. Careful: the Spotify app starts playing the artist right away, alongside Gatefold."
        );
        use-underline: true;
      }
    }
  }

  Adw.PreferencesPage {
    name: "integrations";
    title: _("Integrations");
    icon-name: "applications-utilities-symbolic";

    Adw.PreferencesGroup lyrembed_group {
      title: _("lyrembed");
      description: _("Finds, checks and romanizes lyrics. Its page opens in your browser.");

      Adw.ActionRow lyrembed_status {
        title: _("Status");
        use-markup: false;
      }

      Adw.ActionRow romanize_status {
        title: _("Automatic Romanization");
        use-markup: false;
      }

      Adw.ActionRow layout_hint {
        title: _("Romanization Layout");
        subtitle: _(
          "lyrembed replaces the original lyrics with the romanization. Set “romanization_layout” to “below” in its config to see both."
        );
        visible: false;
      }

      Adw.EntryRow lyrembed_path_row {
        title: _("Program (empty: look in PATH and ~/.local/bin)");
      }
    }

    Adw.PreferencesGroup cdimport_group {
      title: _("cdimport");
      description: _("Rips CDs to tagged FLAC and moves them into your library. Its page opens in your browser.");

      Adw.ActionRow cdimport_status {
        title: _("Status");
        use-markup: false;
      }

      Adw.ActionRow cdimport_library {
        title: _("Imports Go To");
        use-markup: false;
      }

      Adw.EntryRow cdimport_path_row {
        title: _("Program (empty: look in PATH and ~/.local/bin)");
      }
    }

    Adw.PreferencesGroup {
      title: _("Tag Editor");
      description: _("Gatefold never changes your files. Editing opens them in a tag editor.");

      Adw.ComboRow tag_editor_row {
        title: _("_Editor");
        use-underline: true;

        model: Gtk.StringList {
          strings [
            _("Automatic (as in cdimport)"),
            _("Ear Tag"),
            _("Kid3"),
            _("MusicBrainz Picard"),
            _("Custom Command"),
          ]
        };
      }

      Adw.EntryRow tag_editor_command_row {
        title: _("Custom Command ({files} or {dir})");
      }

      Adw.ActionRow ear_tag_status {
        title: _("Ear Tag");
        use-markup: false;
      }
    }
  }
}
