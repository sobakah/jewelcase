using Gtk 4.0;
using Adw 1;

template $JewelcasePreferencesDialog: Adw.PreferencesDialog {
  Adw.PreferencesPage {
    name: "library";
    title: _("Library");
    icon-name: "folder-music-symbolic";
    // Rows are added from preferences_dialog.rs.
    Adw.PreferencesGroup folders_group {
      title: _("Music Folders");
      description: _(
        "Jewelcase reads music from these folders. Symlinked folders and folders inside another music folder can't be added."
      );

      header-suffix: Gtk.Button {
        valign: center;
        action-name: "prefs.add-folder";

        child: Adw.ButtonContent {
          icon-name: "list-add-symbolic";
          label: _("_Add");
          use-underline: true;
        };

        styles [
          "flat",
        ]
      };
    }

    Adw.PreferencesGroup {
      title: _("Start");

      Adw.ComboRow start_view_row {
        title: _("_Open With");
        subtitle: _("The view shown when Jewelcase starts");
        use-underline: true;

        model: Gtk.StringList {
          strings [
            _("Last Used View"),
            _("Albums"),
            _("Artists"),
            _("Playlists"),
          ]
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Appearance");

      Adw.ComboRow style_row {
        title: _("_Style");
        subtitle: _("Light or dark; Follow System uses the desktop’s choice");
        use-underline: true;

        model: Gtk.StringList {
          strings [
            _("Follow System"),
            _("Light"),
            _("Dark"),
          ]
        };
      }

      // Covers keep this size when the window or a panel changes width.
      Adw.ActionRow tile_size_row {
        title: _("_Cover Size");
        subtitle: _("In the album, artist and playlist grids");
        use-underline: true;
        activatable-widget: tile_size_scale;

        [suffix]
        Gtk.Scale tile_size_scale {
          width-request: 200;
          valign: center;
          draw-value: false;
          round-digits: 0;

          adjustment: Gtk.Adjustment {
            lower: 120;
            upper: 280;
            step-increment: 10;
            page-increment: 40;
          };

          accessibility {
            labelled-by: tile_size_row;
          }
        }
      }
    }

    // The sort of playlists that have none of their own (CONCEPT.md
    // §4.1), in the order of playlist_panel.rs: DEFAULT_SORTS.
    Adw.PreferencesGroup {
      title: _("Playlists");
      description: _("How songs are listed in playlists whose sort you haven’t changed. A sort chosen in a playlist stays until you choose “Use Default Sort” there.");

      Adw.ComboRow playlist_sort_row {
        title: _("_Jewelcase Playlists");
        use-underline: true;

        model: Gtk.StringList {
          strings [
            _("Custom Order"),
            _("Title"),
            _("Artist"),
            _("Album"),
            _("Date Added, Oldest First"),
            _("Date Added, Newest First"),
            _("Duration"),
          ]
        };
      }

      Adw.ComboRow spotify_playlist_sort_row {
        title: _("S_potify Playlists");
        subtitle: _("Custom order: as on Spotify");
        use-underline: true;

        model: Gtk.StringList {
          strings [
            _("Custom Order"),
            _("Title"),
            _("Artist"),
            _("Album"),
            _("Date Added, Oldest First"),
            _("Date Added, Newest First"),
            _("Duration"),
          ]
        };
      }
    }

    // Smart shuffle's analysis (CONCEPT.md §7), filled in from
    // preferences_dialog.rs.
    Adw.PreferencesGroup {
      title: _("Song Analysis");
      description: _(
        "Tempo and sound of each song, for “Mix In Similar Songs” and “Keep Playing”. In the background it runs at low priority and waits while on battery; as fast as possible uses several cores, then continues in the background for new songs."
      );

      Adw.ComboRow analysis_row {
        title: _("_Analyze Songs");
        use-underline: true;

        model: Gtk.StringList {
          strings [
            _("Off"),
            _("In the Background"),
            _("Now, as Fast as Possible"),
          ]
        };
      }

      Adw.ActionRow analysis_progress_row {
        title: _("Progress");

        [suffix]
        Gtk.ProgressBar analysis_bar {
          valign: center;
          width-request: 120;
        }

        [suffix]
        Gtk.Button analysis_pause {
          valign: center;
          icon-name: "media-playback-pause-symbolic";
          accessibility {
            label: _("Pause");
          }

          styles [
            "flat",
            "circular",
          ]
        }
      }
    }
  }

  Adw.PreferencesPage {
    name: "playback";
    title: _("Playback");
    icon-name: "media-playback-start-symbolic";

    Adw.PreferencesGroup {
      title: _("Volume");

      Adw.ComboRow replaygain_row {
        title: _("_ReplayGain");
        subtitle: _("Evens out loudness using the volume tags in your files; Off plays them as they are");
        use-underline: true;

        model: Gtk.StringList {
          strings [
            _("Off"),
            _("Automatic"),
            _("Track"),
            _("Album"),
          ]
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Crossfade");
      description: _("Songs fade into each other instead of following gaplessly. Only between your files, not Spotify songs.");

      Adw.SpinRow crossfade_row {
        title: _("_Crossfade");
        subtitle: _("The longest fade, in seconds; 0 is off");
        use-underline: true;

        adjustment: Gtk.Adjustment {
          lower: 0;
          upper: 12;
          step-increment: 1;
          page-increment: 3;
        };
      }

      Adw.SwitchRow crossfade_smart_row {
        title: _("_Smart Crossfade");
        subtitle: _("Fades where a song gets quiet and skips silence at the next song’s start; uses the song analysis (Library page)");
        use-underline: true;
      }

      Adw.SwitchRow crossfade_albums_row {
        title: _("Also Within _Albums");
        subtitle: _("Off: an album playing in order stays gapless");
        use-underline: true;
      }
    }

    // Whether the player opens with its side panes (CONCEPT.md §4.3).
    Adw.PreferencesGroup {
      title: _("Player");

      Adw.ComboRow lyrics_pane_row {
        title: _("_Lyrics Pane");
        subtitle: _("Shown when the player opens");
        use-underline: true;

        model: Gtk.StringList {
          strings [
            _("As Last Left"),
            _("Shown"),
            _("Hidden"),
          ]
        };
      }

      Adw.ComboRow queue_pane_row {
        title: _("Queue _Pane");
        subtitle: _("Shown when the player opens");
        use-underline: true;

        model: Gtk.StringList {
          strings [
            _("As Last Left"),
            _("Shown"),
            _("Hidden"),
          ]
        };
      }

      Adw.SwitchRow visualizer_row {
        title: _("_Visualizer");
        subtitle: _("Bars that move with the music, in the player and the mini player; for songs from your library, while GNOME’s animations are on");
        use-underline: true;
      }
    }

    Adw.PreferencesGroup {
      title: _("Lyrics");

      Adw.ComboRow lyrics_layout_row {
        title: _("_Romanized Lyrics");
        subtitle: _("For lyrics with an original and a romanized line");
        use-underline: true;

        model: Gtk.StringList {
          strings [
            _("Original on Top"),
            _("Romanization on Top"),
            _("Original Only"),
          ]
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Queue");

      Adw.SwitchRow restore_queue_row {
        title: _("Restore _Queue on Start");
        subtitle: _("Reopen the last queue, paused where it stopped");
        use-underline: true;
      }
    }

    Adw.PreferencesGroup {
      title: _("Listening Statistics");
      description: _("Kept on this computer only; nothing is sent anywhere");

      Adw.SwitchRow stats_row {
        title: _("_Keep Listening Statistics");
        subtitle: _("Logs every song that really played: half of it, or 30 seconds");
        use-underline: true;
      }

      Adw.ButtonRow delete_stats_row {
        title: _("_Delete Statistics…");
        use-underline: true;

        styles [
          "destructive-action",
        ]
      }
    }
  }

  Adw.PreferencesPage {
    name: "online";
    title: _("Online");
    icon-name: "network-workgroup-symbolic";

    Adw.PreferencesGroup {
      title: _("Artist Information");
      description: _(
        "Photos, links and short biographies of album artists. Only artist names, album titles and the artists' IDs are sent."
      );

      Adw.SwitchRow online_row {
        title: _("_Look Up Artists Online");
        subtitle: _("MusicBrainz identifies artists and finds their links");
        use-underline: true;
      }

      Adw.SwitchRow wikidata_row {
        title: _("_Wikidata and Wikipedia");
        subtitle: _("Spotify and Wikipedia links, a short biography and a photo from Wikimedia Commons");
        use-underline: true;
        sensitive: bind online_row.active;
      }

      Adw.SwitchRow spotify_photos_row {
        title: _("Photos from _Spotify");
        subtitle: _("The artist’s Spotify picture, while Spotify is connected");
        use-underline: true;
        sensitive: bind online_row.active;
      }

      Adw.SwitchRow deezer_row {
        title: _("Photos from _Deezer");
        subtitle: _("The artist’s Deezer picture, found by name and checked against your albums");
        use-underline: true;
        sensitive: bind online_row.active;
      }
    }

    Adw.PreferencesGroup {
      title: _("Lyrics");

      Adw.SwitchRow lrclib_row {
        title: _("Lyrics for _Spotify Songs");
        subtitle: _("From LRCLIB, for songs that aren’t in your library, while the lyrics are shown; needs “Look Up Artists Online”");
        use-underline: true;
        sensitive: bind online_row.active;
      }
    }

    Adw.PreferencesGroup {
      title: _("Updates");

      Adw.SwitchRow updates_row {
        title: _("Check for _Updates");
        subtitle: _("New versions of Jewelcase, Soloist and soloistd, when Jewelcase starts and twice a day; installed only when you choose to");
        use-underline: true;
      }
    }

    Adw.PreferencesGroup {
      title: _("Links");

      Adw.SwitchRow spotify_app_row {
        title: _("Open Spotify Links in the _App");
        subtitle: _(
          "Otherwise they open in the browser. Careful: the Spotify app starts playing the artist right away, alongside Jewelcase."
        );
        use-underline: true;
      }
    }
  }

  Adw.PreferencesPage {
    name: "integrations";
    title: _("Integrations");
    icon-name: "applications-utilities-symbolic";

    Adw.PreferencesGroup lyrembed_group {
      title: _("lyrembed");
      description: _("Finds, checks and romanizes lyrics. Its page opens in your browser.");

      header-suffix: Gtk.Button {
        icon-name: "view-refresh-symbolic";
        tooltip-text: _("Look Again");
        action-name: "app.detect-tools";
        valign: center;

        styles [
          "flat",
        ]
      };

      Adw.ActionRow lyrembed_status {
        title: _("Status");
        use-markup: false;
      }

      Adw.ActionRow romanize_status {
        title: _("Automatic Romanization");
        use-markup: false;
      }

      Adw.ActionRow layout_hint {
        title: _("Romanization Layout");
        subtitle: _(
          "lyrembed replaces the original lyrics with the romanization. Set “romanization_layout” to “below” in its config to see both."
        );
        visible: false;
      }

      Adw.EntryRow lyrembed_path_row {
        title: _("Program (empty: look in PATH and ~/.local/bin)");
      }
    }

    // How to install lyrembed, filled in from preferences_dialog.rs.
    Adw.PreferencesGroup lyrembed_setup {
      visible: false;

      Gtk.ListBox lyrembed_steps {
        selection-mode: none;

        styles [
          "boxed-list",
        ]
      }
    }

    Adw.PreferencesGroup cdport_group {
      title: _("cdport");
      description: _("Rips CDs to tagged FLAC and moves them into your library. Its page opens in your browser.");

      header-suffix: Gtk.Button {
        icon-name: "view-refresh-symbolic";
        tooltip-text: _("Look Again");
        action-name: "app.detect-tools";
        valign: center;

        styles [
          "flat",
        ]
      };

      Adw.ActionRow cdport_status {
        title: _("Status");
        use-markup: false;
      }

      Adw.ActionRow cdport_library {
        title: _("Imports Go To");
        use-markup: false;
      }

      Adw.EntryRow cdport_path_row {
        title: _("Program (empty: look in PATH and ~/.local/bin)");
      }
    }

    // How to install or set up cdport, filled in from preferences_dialog.rs.
    Adw.PreferencesGroup cdport_setup {
      visible: false;

      Gtk.ListBox cdport_steps {
        selection-mode: none;

        styles [
          "boxed-list",
        ]
      }
    }

    Adw.PreferencesGroup tag_editor_group {
      title: _("Tag Editor");
      description: _("Jewelcase never changes your files. Editing opens them in a tag editor: cdport’s opens in your browser, one album at a time.");

      Adw.ComboRow tag_editor_row {
        title: _("_Editor");
        use-underline: true;

        model: Gtk.StringList {
          strings [
            "cdport",
            _("Ear Tag"),
            _("Kid3"),
            _("MusicBrainz Picard"),
            _("Custom Command"),
          ]
        };
      }

      Adw.EntryRow tag_editor_command_row {
        title: _("Custom Command ({files} or {dir})");
      }

      Adw.ActionRow ear_tag_status {
        title: _("Ear Tag");
        use-markup: false;
      }
    }
  }
}
