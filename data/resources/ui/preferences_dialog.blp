using Gtk 4.0;
using Adw 1;

template $GatefoldPreferencesDialog: Adw.PreferencesDialog {
  Adw.PreferencesPage {
    title: _("Library");
    icon-name: "folder-music-symbolic";

    // Rows are added from preferences_dialog.rs.
    Adw.PreferencesGroup folders_group {
      title: _("Music Folders");
      description: _("Gatefold reads music from these folders. Symlinked folders and folders inside another music folder can't be added.");

      header-suffix: Gtk.Button {
        valign: center;
        action-name: "prefs.add-folder";

        child: Adw.ButtonContent {
          icon-name: "list-add-symbolic";
          label: _("_Add");
          use-underline: true;
        };

        styles [
          "flat",
        ]
      };
    }
  }

  Adw.PreferencesPage {
    title: _("Playback");
    icon-name: "media-playback-start-symbolic";

    Adw.PreferencesGroup {
      title: _("Volume");

      Adw.ComboRow replaygain_row {
        title: _("_ReplayGain");
        subtitle: _("Evens out loudness using the volume tags in your files");
        use-underline: true;

        model: Gtk.StringList {
          strings [
            _("Off"),
            _("Automatic"),
            _("Track"),
            _("Album"),
          ]
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Queue");

      Adw.SwitchRow restore_queue_row {
        title: _("Restore _Queue on Start");
        subtitle: _("Reopen the last queue, paused where it stopped");
        use-underline: true;
      }
    }
  }
}
