using Gtk 4.0;
using Adw 1;
// The full player in the expanded bottom sheet (CONCEPT.md §4.3).
// Wide: lyrics and queue panes sit next to the cover. Narrow: a pane
// replaces the cover, and a small cover moves into the header. The
// breakpoints are added in player_view.rs.
template $JewelcasePlayerView: Adw.Bin {
  styles [
    "player-view",
  ]

  child: Adw.BreakpointBin breakpoint_bin {
    width-request: 360;
    height-request: 294;

    child: Gtk.Overlay overlay {
      // Blurred cover and the cover-color tint behind everything.
      child: Gtk.Picture backdrop {
        content-fit: cover;
        can-shrink: true;

        styles [
          "player-backdrop",
        ]
      };

      [overlay]
      Gtk.Box tint {
        can-target: false;

        styles [
          "player-tint",
        ]
      }

      [overlay]
      Adw.ToolbarView toolbar {
        [top]
        Adw.HeaderBar {
          title-widget: Gtk.Box header_track {
            spacing: 9;
            visible: false;

            $JewelcaseCoverImage header_cover {
              min-size: 28;
              natural-size: 28;
              kind: "grid";
              valign: center;
            }

            Gtk.Label header_title {
              ellipsize: end;
              max-width-chars: 30;

              styles [
                "heading",
              ]
            }
          };

          // Hidden by the grip on top (like the side panels), dragging
          // down, or Escape; no arrow besides.

          // Spotify Connect devices (CONCEPT.md §9.3).
          [end]
          Gtk.MenuButton devices_button {
            icon-name: "preferences-system-devices-symbolic";
            tooltip-text: _("Play On…");
            direction: down;
            visible: false;

            popover: Gtk.Popover devices_popover {};

            styles [
              "flat",
              "circular",
            ]
          }

          // More about the song: format, bitrate, release, tags.
          [end]
          Gtk.MenuButton info_button {
            icon-name: "info-outline-symbolic";
            tooltip-text: _("Song Info");
            direction: down;

            popover: Gtk.Popover info_popover {};

            styles [
              "flat",
              "circular",
            ]
          }

          styles [
            "flat",
          ]
        }

        // Remote mode: a Spotify device plays, these controls steer it.
        [top]
        Adw.Banner remote_banner {
          button-label: _("Play _Here");
        }

        // The first layout ("wide") is the default.
        content: Adw.MultiLayoutView layout_view {
          Adw.Layout {
            name: "wide";

            content: Gtk.Box {
              spacing: 24;
              margin-start: 24;
              margin-end: 24;
              margin-bottom: 24;
              // Lyrics open to the left of the player, the queue to the
              // right; the player itself stays in the middle.
              Adw.LayoutSlot {
                id: "lyrics";
              }

              Gtk.Box {
                orientation: vertical;
                spacing: 18;
                hexpand: true;
                width-request: 360;

                Adw.LayoutSlot {
                  id: "cover";
                  vexpand: true;
                }

                Adw.LayoutSlot {
                  id: "info";
                }
              }

              Adw.LayoutSlot {
                id: "queue";
              }
            };
          }

          Adw.Layout {
            name: "narrow";

            content: Gtk.Box {
              orientation: vertical;
              spacing: 18;
              margin-start: 18;
              margin-end: 18;
              margin-bottom: 18;

              Gtk.Stack narrow_stack {
                vexpand: true;
                transition-type: crossfade;

                Gtk.StackPage {
                  name: "cover";

                  child: Adw.LayoutSlot {
                    id: "cover";
                  };
                }

                Gtk.StackPage {
                  name: "lyrics";

                  child: Adw.LayoutSlot {
                    id: "lyrics";
                  };
                }

                Gtk.StackPage {
                  name: "queue";

                  child: Adw.LayoutSlot {
                    id: "queue";
                  };
                }
              }

              Adw.LayoutSlot {
                id: "info";
              }
            };
          }

          [cover]
          $JewelcaseCoverImage cover {
            min-size: 96;
            natural-size: 520;
            kind: "player";
            shrinkable: true;
          }

          [lyrics]
          $JewelcaseLyricsView lyrics_view {
            width-request: 320;
            hexpand: true;
          }

          [queue]
          $JewelcaseQueueView queue_view {
            width-request: 340;
          }

          [info]
          Gtk.Box {
            orientation: vertical;
            spacing: 18;

            // The music as bars, between the cover and the title.
            Adw.Clamp {
              maximum-size: 420;

              child: $JewelcaseVisualizer visualizer {
                bars: 32;
                height-request: 36;
              };
            }

            Gtk.CenterBox {
              center-widget: Gtk.Box {
                orientation: vertical;
                spacing: 3;

                // The Spotify icon marks a song playing from Spotify.
                Gtk.Box {
                  halign: center;
                  spacing: 8;

                  // Spotify's guidelines: at least 21 px, black or white.
                  Gtk.Image spotify_mark {
                    icon-name: "jewelcase-spotify-symbolic";
                    pixel-size: 21;
                    valign: center;
                    visible: false;
                    tooltip-text: _("Plays from Spotify");

                    styles [
                      "spotify-logo",
                    ]
                  }

                  Gtk.Label title {
                    label: _("Not Playing");
                    ellipsize: end;

                    styles [
                      "title-2",
                    ]
                  }
                }

                Gtk.Label subtitle {
                  label: _("Pick an album to start");
                  ellipsize: end;

                  styles [
                    "dim-label",
                    "player-subtitle",
                  ]
                }
              };

              // The song into a playlist (the tooltip says which have
              // it already); the volume balances it on the other side.
              start-widget: Gtk.Button playlist_button {
                icon-name: "list-add-symbolic";
                tooltip-text: _("Add to Playlist…");
                valign: center;
                sensitive: false;

                styles [
                  "flat",
                  "circular",
                ]
              };

              end-widget: Gtk.MenuButton volume_button {
                icon-name: "audio-volume-high-symbolic";
                accessibility {
                  label: _("Volume");
                }

                direction: up;

                popover: Gtk.Popover {
                  child: Gtk.Scale volume_scale {
                    width-request: 200;
                    draw-value: false;

                    adjustment: Gtk.Adjustment volume_adjustment {
                      lower: 0;
                      upper: 1;
                      step-increment: 0.05;
                      page-increment: 0.1;
                    };
                  };
                };

                styles [
                  "flat",
                  "circular",
                ]
              };
            }

            Adw.Clamp {
              maximum-size: 560;

              child: Gtk.Box {
                spacing: 6;

                Gtk.Label position_label {
                  label: "0:00";
                  width-chars: 5;

                  styles [
                    "caption",
                    "numeric",
                  ]
                }

                Gtk.Scale seek {
                  hexpand: true;

                  adjustment: Gtk.Adjustment seek_adjustment {
                    lower: 0;
                    upper: 1;
                    step-increment: 5000;
                    page-increment: 30000;
                  };
                }

                Gtk.Label duration_label {
        // A button for assistive technology and the keyboard (Enter,
        // Space): switches between length and remaining time.
        accessible-role: button;
                  label: "0:00";
                  width-chars: 5;

                  styles [
                    "caption",
                    "numeric",
                  ]
                }
              };
            }

            Gtk.CenterBox {
              start-widget: Gtk.ToggleButton lyrics_button {
                tooltip-text: _("Lyrics (Ctrl+L)");
                valign: center;

                child: Adw.ButtonContent lyrics_content {
                  icon-name: "jewelcase-lyrics-symbolic";
                  label: _("Lyrics");
                };

                styles [
                  "flat",
                ]
              };

              center-widget: Gtk.Box transport {
                spacing: 18;
                // Shuffle, and its options (smart shuffle, §7).
                Gtk.Box {
                  valign: center;

                  Gtk.ToggleButton shuffle_button {
                    icon-name: "media-playlist-shuffle-symbolic";
                    accessibility {
                      label: _("Shuffle");
                    }

                    action-name: "player.shuffle";
                    valign: center;

                    styles [
                      "flat",
                      "circular",
                    ]
                  }

                  Gtk.MenuButton shuffle_options {
                    icon-name: "pan-down-symbolic";
                    tooltip-text: _("Shuffle Options");
                    valign: center;
                    direction: up;

                    styles [
                      "flat",
                      "options-arrow",
                    ]
                  }
                }

                Gtk.Button {
                  icon-name: "media-skip-backward-symbolic";
                  accessibility {
                    label: _("Previous");
                  }

                  action-name: "player.previous";
                  valign: center;

                  styles [
                    "flat",
                    "circular",
                  ]
                }

                Gtk.Button play_button {
                  icon-name: "media-playback-start-symbolic";
                  accessibility {
                    label: _("Play");
                  }

                  action-name: "player.play-pause";

                  styles [
                    "circular",
                    "suggested-action",
                    "play-button",
                  ]
                }

                Gtk.Button {
                  icon-name: "media-skip-forward-symbolic";
                  accessibility {
                    label: _("Next");
                  }

                  action-name: "player.next";
                  valign: center;

                  styles [
                    "flat",
                    "circular",
                  ]
                }

                // Repeat cycles; the arrow picks a mode directly.
                Gtk.Box {
                  valign: center;

                  Gtk.Button repeat_button {
                    icon-name: "media-playlist-consecutive-symbolic";
                    accessibility {
                      label: _("Repeat: Off");
                    }

                    action-name: "player.repeat";
                    valign: center;

                    styles [
                      "flat",
                      "circular",
                    ]
                  }

                  Gtk.MenuButton repeat_options {
                    icon-name: "pan-down-symbolic";
                    tooltip-text: _("Repeat Options");
                    valign: center;
                    direction: up;

                    styles [
                      "flat",
                      "options-arrow",
                    ]
                  }
                }
              };

              end-widget: Gtk.Box {
                spacing: 6;
                valign: center;

                Gtk.ToggleButton queue_button {
                  tooltip-text: _("Queue (Ctrl+U)");

                  child: Adw.ButtonContent queue_content {
                    icon-name: "view-list-symbolic";
                    label: _("Queue");
                  };

                  styles [
                    "flat",
                  ]
                }
              };
            }
          }
        };
      }

      // The grip on top, like the one on the side panels' edge: drag the
      // player down, or click it, to hide it (the bottom sheet's own
      // handle can't be clicked).
      [overlay]
      Gtk.Button {
        action-name: "win.close-player";
        halign: center;
        valign: start;

        accessibility {
          label: _("Hide Player");
        }

        child: Gtk.Box {
          halign: center;
          valign: center;

          styles [
            "grip",
          ]
        };

        styles [
          "sheet-close-handle",
        ]
      }
    };
  };
}
