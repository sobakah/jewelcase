using Gtk 4.0;
using Adw 1;

// The full player in the expanded bottom sheet (CONCEPT.md §4.3). The
// Queue toggle swaps the cover for the queue; lyrics arrive in phase 3.
template $GatefoldPlayerView: Adw.Bin {
  styles [
    "player-view",
  ]

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-title: false;

      [start]
      Gtk.Button {
        icon-name: "pan-down-symbolic";
        tooltip-text: _("Hide Player");
        action-name: "win.close-player";
      }
    }

    content: Gtk.Box {
      orientation: vertical;
      spacing: 18;
      margin-start: 24;
      margin-end: 24;
      margin-bottom: 24;

      Gtk.Stack pane_stack {
        vexpand: true;
        transition-type: crossfade;

        Gtk.StackPage {
          name: "cover";

          child: $GatefoldCoverImage cover {
            min-size: 96;
            natural-size: 480;
            kind: "player";
            shrinkable: true;
          };
        }

        Gtk.StackPage {
          name: "queue";

          child: Adw.Clamp {
            maximum-size: 560;

            child: Gtk.Box {
              orientation: vertical;
              spacing: 6;

              Gtk.Box {
                Gtk.Label {
                  label: _("Queue");
                  xalign: 0;
                  hexpand: true;

                  styles [
                    "heading",
                  ]
                }

                Gtk.Button {
                  label: _("_Clear");
                  use-underline: true;
                  tooltip-text: _("Clear Upcoming Songs");
                  action-name: "player.clear-queue";

                  styles [
                    "flat",
                  ]
                }
              }

              Gtk.ScrolledWindow {
                vexpand: true;
                hscrollbar-policy: never;

                child: Gtk.ListBox queue_list {
                  selection-mode: none;
                  valign: start;

                  styles [
                    "boxed-list",
                  ]
                };
              }
            };
          };
        }
      }

      Gtk.Box {
        orientation: vertical;
        spacing: 3;

        Gtk.Label title {
          label: _("Not Playing");
          ellipsize: end;
          selectable: true;

          styles [
            "title-2",
          ]
        }

        Gtk.Label subtitle {
          label: _("Pick an album to start");
          ellipsize: end;

          styles [
            "dim-label",
          ]
        }
      }

      Adw.Clamp {
        maximum-size: 560;

        child: Gtk.Box {
          spacing: 6;

          Gtk.Label position_label {
            label: "0:00";
            width-chars: 5;

            styles [
              "caption",
              "numeric",
            ]
          }

          Gtk.Scale seek {
            hexpand: true;

            adjustment: Gtk.Adjustment seek_adjustment {
              lower: 0;
              upper: 1;
              step-increment: 5000;
              page-increment: 30000;
            };
          }

          Gtk.Label duration_label {
            label: "0:00";
            width-chars: 5;

            styles [
              "caption",
              "numeric",
            ]
          }
        };
      }

      Gtk.Box {
        halign: center;
        spacing: 18;

        Gtk.ToggleButton {
          icon-name: "media-playlist-shuffle-symbolic";
          tooltip-text: _("Shuffle");
          action-name: "player.shuffle";
          valign: center;

          styles [
            "flat",
            "circular",
          ]
        }

        Gtk.Button {
          icon-name: "media-skip-backward-symbolic";
          tooltip-text: _("Previous");
          action-name: "player.previous";
          valign: center;

          styles [
            "flat",
            "circular",
          ]
        }

        Gtk.Button play_button {
          icon-name: "media-playback-start-symbolic";
          tooltip-text: _("Play");
          action-name: "player.play-pause";

          styles [
            "circular",
            "suggested-action",
            "play-button",
          ]
        }

        Gtk.Button {
          icon-name: "media-skip-forward-symbolic";
          tooltip-text: _("Next");
          action-name: "player.next";
          valign: center;

          styles [
            "flat",
            "circular",
          ]
        }

        Gtk.Button repeat_button {
          icon-name: "media-playlist-consecutive-symbolic";
          tooltip-text: _("Repeat: Off");
          action-name: "player.repeat";
          valign: center;

          styles [
            "flat",
            "circular",
          ]
        }
      }

      Gtk.Box {
        halign: end;
        spacing: 6;

        Gtk.ToggleButton {
          action-name: "player.show-lyrics";
          tooltip-text: _("Lyrics arrive in a later version");

          child: Adw.ButtonContent {
            icon-name: "gatefold-lyrics-symbolic";
            label: _("Lyrics");
          };

          styles [
            "flat",
          ]
        }

        Gtk.ToggleButton queue_button {
          child: Adw.ButtonContent {
            icon-name: "view-list-symbolic";
            label: _("Queue");
          };

          styles [
            "flat",
          ]
        }
      }
    };
  };
}
