using Gtk 4.0;
using Adw 1;
// Bottom bar of the library window (CONCEPT.md §4.1): a compact, centered
// player. Clicking the arrow (or swiping up) opens the full player; the
// queue button opens the queue as a card.
template $JewelcaseMiniPlayer: Adw.Bin {
  styles [
    "mini-player",
  ]

  child: Gtk.Box {
    orientation: vertical;
    margin-start: 18;
    margin-end: 18;
    margin-top: 12;
    margin-bottom: 9;
    spacing: 6;

    Gtk.Box {
      spacing: 12;

      $JewelcaseCoverImage cover {
        min-size: 68;
        natural-size: 68;
        valign: center;
      }

      Gtk.Box text_box {
        orientation: vertical;
        valign: center;
        width-request: 180;

        Gtk.Box {
          spacing: 6;

          Gtk.Image spotify_mark {
            icon-name: "jewelcase-spotify-symbolic";
            pixel-size: 14;
            valign: center;
            visible: false;
            tooltip-text: _("Plays from Spotify");
          }

          Gtk.Label title {
            label: _("Not Playing");
            xalign: 0;
            ellipsize: end;
            max-width-chars: 30;

            styles [
              "title-4",
            ]
          }
        }

        Gtk.Label artist {
          xalign: 0;
          ellipsize: end;
          max-width-chars: 28;
          visible: false;

          styles [
            "dim-label",
            "caption",
          ]
        }
      }

      // The space between the song and the controls, which keeps the
      // controls on the right even with the visualizer off. In it, the
      // music as bars: as many as fit (more and taller in a wide window).
      Gtk.Box {
        hexpand: true;

        $JewelcaseVisualizer {
          slot: 7;
          fill: 0.6;
          min-bars: 4;
          max-bars: 24;
          hexpand: true;
          height-request: 22;
        }
      }

      Gtk.Box {
        spacing: 9;
        valign: center;

        Gtk.ToggleButton shuffle_button {
          visible: bind template.compact inverted;
          icon-name: "media-playlist-shuffle-symbolic";
          accessibility {
            label: _("Shuffle");
          }

          action-name: "player.shuffle";
          valign: center;

          styles [
            "flat",
            "circular",
          ]
        }

        Gtk.Button {
          icon-name: "media-skip-backward-symbolic";
          accessibility {
            label: _("Previous");
          }

          action-name: "player.previous";
          valign: center;

          styles [
            "flat",
            "circular",
          ]
        }

        Gtk.Button play_button {
          icon-name: "media-playback-start-symbolic";
          accessibility {
            label: _("Play");
          }

          action-name: "player.play-pause";
          valign: center;

          styles [
            "circular",
            "suggested-action",
            "mini-play-button",
          ]
        }

        Gtk.Button {
          icon-name: "media-skip-forward-symbolic";
          accessibility {
            label: _("Next");
          }

          action-name: "player.next";
          valign: center;

          styles [
            "flat",
            "circular",
          ]
        }

        Gtk.Button repeat_button {
          visible: bind template.compact inverted;
          icon-name: "media-playlist-consecutive-symbolic";
          accessibility {
            label: _("Repeat: Off");
          }

          action-name: "player.repeat";
          valign: center;

          styles [
            "flat",
            "circular",
          ]
        }
      }

      Gtk.Box {
        spacing: 3;
        valign: center;
        margin-start: 6;
        // The queue as a card above the bar, to view and change it.
        Gtk.MenuButton queue_button {
          visible: bind template.compact inverted;
          icon-name: "view-list-ordered-symbolic";
          tooltip-text: _("Queue");
          direction: up;

          popover: Gtk.Popover queue_popover {
            styles [
              "queue-card",
            ]
          };

          styles [
            "flat",
            "circular",
          ]
        }

        Gtk.Button {
          icon-name: "pan-up-symbolic";
          accessibility {
            label: _("Show Player");
          }

          action-name: "win.open-player";

          styles [
            "flat",
            "circular",
          ]
        }
      }
    }

    Gtk.Box {
      spacing: 6;

      Gtk.Label position_label {
        label: "0:00";
        width-chars: 5;
        xalign: 1;

        styles [
          "dim-label",
          "caption",
          "numeric",
        ]
      }

      Gtk.Scale seek {
        hexpand: true;

        adjustment: Gtk.Adjustment seek_adjustment {
          lower: 0;
          upper: 1;
        };

        styles [
          "mini-seek",
        ]
      }

      Gtk.Label duration_label {
        // A button for assistive technology and the keyboard (Enter,
        // Space): switches between length and remaining time.
        accessible-role: button;
        label: "0:00";
        width-chars: 5;
        xalign: 0;

        styles [
          "dim-label",
          "caption",
          "numeric",
        ]
      }
    }
  };
}
