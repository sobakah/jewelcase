using Gtk 4.0;
using Adw 1;
// Library window with the player in a bottom sheet (CONCEPT.md §4).
template $GatefoldWindow: Adw.ApplicationWindow {
  default-width: 1100;
  default-height: 760;
  width-request: 360;
  height-request: 294;
  title: _("Gatefold");
  // Only the last matching breakpoint applies, so the narrow one repeats
  // the album panel setter.
  Adw.Breakpoint {
    condition ("max-width: 700sp")

    setters {
      split_view.collapsed: true;
      playlist_split.collapsed: true;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 550sp")

    setters {
      header_bar.show-title: false;
      switcher_bar.reveal: true;
      split_view.collapsed: true;
      playlist_split.collapsed: true;
    }
  }

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.BottomSheet bottom_sheet {
      // The sheet doesn't pad its content, so keep the switcher bar and the
      // ends of the lists clear of the mini player.
      content: Adw.ToolbarView {
        margin-bottom: bind bottom_sheet.bottom-bar-height;

        [top]
        Adw.HeaderBar header_bar {
          title-widget: Adw.ViewSwitcher {
            stack: stack;
            policy: wide;
          };

          [start]
          Gtk.MenuButton playlist_button {
            icon-name: "list-add-symbolic";
            tooltip-text: _("New Playlist");
            menu-model: playlist_menu;
            visible: false;
          }

          [start]
          Gtk.MenuButton sort_button {
            icon-name: "view-sort-descending-symbolic";
            tooltip-text: _("Sort Albums");
            menu-model: sort_menu;
          }

          [end]
          Gtk.MenuButton {
            primary: true;
            icon-name: "open-menu-symbolic";
            tooltip-text: _("Main Menu");
            menu-model: primary_menu;
          }

          [end]
          Gtk.ToggleButton search_button {
            icon-name: "system-search-symbolic";
            tooltip-text: _("Search");
          }
        }

        [top]
        Gtk.SearchBar search_bar {
          search-mode-enabled: bind search_button.active bidirectional;

          child: Adw.Clamp {
            maximum-size: 480;

            child: Gtk.SearchEntry search_entry {
              hexpand: true;
              placeholder-text: _("Search artists, albums, songs and playlists");
            };
          };
        }

        [top]
        Adw.Banner scan_banner {
          revealed: false;
        }

        // While a companion tool's page is open (CONCEPT.md §10.0).

        [top]
        Gtk.Revealer tool_revealer {
          transition-type: slide_down;

          child: Gtk.Box {
            spacing: 6;

            styles [
              "tool-bar",
            ]

            Gtk.Label tool_label {
              hexpand: true;
              ellipsize: end;
            }

            Gtk.Button {
              label: _("_Show Page");
              use-underline: true;
              action-name: "app.tool-show-page";
              valign: center;
            }

            Gtk.Button {
              label: _("_Stop");
              use-underline: true;
              action-name: "app.tool-stop";
              valign: center;
            }
          };
        }

        [top]
        Adw.Banner cd_banner {
          title: _("Audio CD detected");
          button-label: _("_Import");
          action-name: "app.import-cd";
          revealed: false;
        }

        [top]
        Adw.Banner unfinished_banner {
          button-label: _("_Continue");
          action-name: "app.continue-import";
          revealed: false;
        }

        // The library views, or search results while searching.
        content: Gtk.Stack main_stack {
          transition-type: crossfade;

          Gtk.StackPage {
            name: "library";

            child: Adw.ViewStack stack {
              Adw.ViewStackPage {
                name: "albums";
                title: _("Albums");
                icon-name: "media-optical-symbolic";

                child: Gtk.Stack albums_stack {
                  transition-type: crossfade;

                  Gtk.StackPage {
                    name: "empty";

                    child: Adw.StatusPage {
                      icon-name: "folder-music-symbolic";
                      title: _("No Albums Yet");
                      description: _("Gatefold shows the albums in your music folders.");

                      child: Gtk.Button {
                        halign: center;
                        label: _("_Choose Music Folders…");
                        use-underline: true;
                        action-name: "app.preferences";

                        styles [
                          "pill",
                        ]
                      };
                    };
                  }

                  Gtk.StackPage {
                    name: "scanning";

                    child: Adw.StatusPage {
                      title: _("Looking for Music…");
                      description: _("Albums show up here as soon as they're found.");

                      child: Adw.Spinner {
                        height-request: 48;
                        width-request: 48;
                      };
                    };
                  }

                  Gtk.StackPage {
                    name: "albums";

                    child: Adw.OverlaySplitView split_view {
                      sidebar-position: end;
                      show-sidebar: false;
                      min-sidebar-width: 320;
                      max-sidebar-width: 440;
                      sidebar-width-fraction: 0.38;

                      content: Gtk.ScrolledWindow {
                        hscrollbar-policy: never;

                        child: Gtk.GridView album_grid {
                          max-columns: 12;
                          min-columns: 2;
                          single-click-activate: true;

                          styles [
                            "album-grid",
                          ]
                        };
                      };

                      sidebar: $GatefoldAlbumPanel album_panel {};
                    };
                  }
                };
              }

              Adw.ViewStackPage {
                name: "artists";
                title: _("Artists");
                icon-name: "avatar-default-symbolic";
                // Artist pages open over most of the grid (CONCEPT.md §4.2).
                child: Adw.OverlaySplitView artist_split {
                  collapsed: true;
                  sidebar-position: end;
                  show-sidebar: false;
                  min-sidebar-width: 360;
                  max-sidebar-width: 968;

                  styles [
                    "artist-overlay",
                  ]

                  sidebar: Adw.Bin artist_holder {};

                  content: Gtk.Stack artists_stack {
                    transition-type: crossfade;

                    Gtk.StackPage {
                      name: "ask";

                      child: Adw.StatusPage {
                        icon-name: "avatar-default-symbolic";
                        title: _("Show Artist Photos and Links?");
                        description: _(
                          "Gatefold can look up artists online: MusicBrainz identifies them, Wikidata, Wikipedia and Wikimedia Commons add links, a short biography and a photo, and fanart.tv adds photos if you enter an API key in Preferences. Only artist names and MusicBrainz IDs are sent. You can change this any time in Preferences."
                        );

                        child: Gtk.Box {
                          halign: center;
                          spacing: 12;

                          Gtk.Button {
                            label: _("_Not Now");
                            use-underline: true;
                            action-name: "win.online-metadata";
                            action-target: "false";

                            styles [
                              "pill",
                            ]
                          }

                          Gtk.Button {
                            label: _("_Look Up Artists");
                            use-underline: true;
                            action-name: "win.online-metadata";
                            action-target: "true";

                            styles [
                              "pill",
                              "suggested-action",
                            ]
                          }
                        };
                      };
                    }

                    Gtk.StackPage {
                      name: "empty";

                      child: Adw.StatusPage {
                        icon-name: "avatar-default-symbolic";
                        title: _("No Artists Yet");
                        description: _("Album artists from your library will show up here.");
                      };
                    }

                    Gtk.StackPage {
                      name: "artists";

                      child: Gtk.ScrolledWindow {
                        hscrollbar-policy: never;

                        child: Gtk.GridView artist_grid {
                          max-columns: 12;
                          min-columns: 2;
                          single-click-activate: true;

                          styles [
                            "artist-grid",
                          ]
                        };
                      };
                    }
                  };
                };
              }

              Adw.ViewStackPage {
                name: "playlists";
                title: _("Playlists");
                icon-name: "view-list-bullet-symbolic";

                child: Gtk.Stack playlists_stack {
                  transition-type: crossfade;

                  Gtk.StackPage {
                    name: "empty";

                    child: Adw.StatusPage {
                      icon-name: "view-list-bullet-symbolic";
                      title: _("No Playlists Yet");
                      description: _("Create a playlist, or import an M3U or XSPF file.");

                      child: Gtk.Box {
                        halign: center;
                        spacing: 12;

                        Gtk.Button {
                          label: _("_Import…");
                          use-underline: true;
                          action-name: "win.import-playlist";

                          styles [
                            "pill",
                          ]
                        }

                        Gtk.Button {
                          label: _("_New Playlist");
                          use-underline: true;
                          action-name: "win.new-playlist";

                          styles [
                            "pill",
                            "suggested-action",
                          ]
                        }
                      };
                    };
                  }

                  Gtk.StackPage {
                    name: "playlists";

                    child: Adw.OverlaySplitView playlist_split {
                      sidebar-position: end;
                      show-sidebar: false;
                      min-sidebar-width: 320;
                      max-sidebar-width: 440;
                      sidebar-width-fraction: 0.38;

                      content: Gtk.ScrolledWindow {
                        hscrollbar-policy: never;

                        child: Gtk.GridView playlist_grid {
                          max-columns: 12;
                          min-columns: 2;
                          single-click-activate: true;

                          styles [
                            "album-grid",
                          ]
                        };
                      };

                      sidebar: $GatefoldPlaylistPanel playlist_panel {};
                    };
                  }
                };
              }
            };
          }

          Gtk.StackPage {
            name: "search";

            child: $GatefoldSearchView search_view {};
          }
        };

        [bottom]
        Adw.ViewSwitcherBar switcher_bar {
          stack: stack;
        }
      };

      bottom-bar: $GatefoldMiniPlayer {};

      sheet: $GatefoldPlayerView player_view {};
    };
  };
}

menu playlist_menu {
  section {
    item {
      label: _("_New Playlist…");
      action: "win.new-playlist";
    }

    item {
      label: _("_Import Playlist…");
      action: "win.import-playlist";
    }
  }
}

menu sort_menu {
  section {
    label: _("Sort By");

    item {
      label: _("_Artist");
      action: "win.album-sort";
      target: "artist";
    }

    item {
      label: _("_Title");
      action: "win.album-sort";
      target: "title";
    }

    item {
      label: _("_Year");
      action: "win.album-sort";
      target: "year";
    }

    item {
      label: _("Date _Added");
      action: "win.album-sort";
      target: "added";
    }
  }
}

menu primary_menu {
  section {
    item {
      label: _("_Import CD…");
      action: "app.import-cd";
    }

    item {
      label: _("_Rescan Library");
      action: "app.rescan";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Gatefold");
      action: "app.about";
    }
  }
}
