using Gtk 4.0;
using Adw 1;
// Library window with the player in a bottom sheet (CONCEPT.md §4).
template $JewelcaseWindow: Adw.ApplicationWindow {
  default-width: 1100;
  default-height: 760;
  width-request: 360;
  height-request: 294;
  title: _("Jewelcase");
  // Only the last matching breakpoint applies, so the narrow one repeats
  // the album panel setter.
  Adw.Breakpoint {
    condition ("max-width: 700sp")

    setters {
      split_view.collapsed: true;
      playlist_split.collapsed: true;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 640sp")

    setters {
      header_bar.show-title: false;
      switcher_bar.reveal: true;
      bottom_sheet.full-width: true;
      mini_player.compact: true;
      split_view.collapsed: true;
      playlist_split.collapsed: true;
    }
  }

  content: Adw.ToastOverlay toast_overlay {
    // Not full width: the mini player is a compact bar in the middle, and
    // the player sheet only as wide as it needs (CONCEPT.md §4.3).
    child: Adw.BottomSheet bottom_sheet {
      full-width: false;
      // The player draws its own grip, which can also be clicked.
      show-drag-handle: false;
      // The mini player floats over the content (window.rs keeps the
      // switcher bar clear of it on narrow windows).
      content: Adw.ToolbarView library_toolbar {
        [top]
        Adw.HeaderBar header_bar {
          title-widget: Adw.ViewSwitcher {
            stack: stack;
            policy: wide;
          };

          [start]
          Gtk.MenuButton playlist_button {
            icon-name: "list-add-symbolic";
            tooltip-text: _("New Playlist");
            menu-model: playlist_menu;
            visible: false;
          }

          [start]
          Gtk.MenuButton sort_button {
            icon-name: "view-sort-descending-symbolic";
            tooltip-text: _("Sort and Filter Albums");
            menu-model: sort_menu;
          }

          [end]
          Gtk.MenuButton {
            primary: true;
            icon-name: "open-menu-symbolic";
            accessibility {
              label: _("Main Menu");
            }

            menu-model: primary_menu;
          }

          [end]
          Gtk.ToggleButton search_button {
            icon-name: "system-search-symbolic";
            tooltip-text: _("Search (Ctrl+F)");
          }

          // New releases of followed artists (window.rs, widgets/new_releases.rs).
          [end]
          Gtk.MenuButton new_releases_button {
            tooltip-text: _("New Releases");
            visible: false;
            // A child instead of an icon name (for the dot): flat like the
            // other header bar buttons.
            has-frame: false;
            popover: Gtk.Popover new_releases_popover {};

            child: Gtk.Overlay {
              child: Gtk.Image {
                icon-name: "preferences-system-notifications-symbolic";
              };

              [overlay]
              Gtk.Box new_releases_dot {
                halign: end;
                valign: start;
                can-target: false;
                visible: false;

                styles [
                  "new-dot",
                ]
              }
            };
          }

          // While something on screen loads from Spotify (window.rs).
          [end]
          Gtk.Revealer spotify_loading {
            transition-type: crossfade;
            visible: false;

            child: Adw.Spinner {
              width-request: 16;
              height-request: 16;
              margin-start: 6;
              margin-end: 6;
              tooltip-text: _("Loading from Spotify…");
            };
          }
        }

        [top]
        Gtk.SearchBar search_bar {
          search-mode-enabled: bind search_button.active bidirectional;

          child: Adw.Clamp {
            maximum-size: 480;

            child: Gtk.SearchEntry search_entry {
              hexpand: true;
              placeholder-text: _("Search artists, albums, songs and playlists");
            };
          };
        }

        [top]
        Adw.Banner scan_banner {
          revealed: false;
        }

        // While a companion tool's page is open (CONCEPT.md §10.0).

        [top]
        Gtk.Revealer tool_revealer {
          transition-type: slide_down;

          child: Gtk.Box {
            spacing: 6;

            styles [
              "tool-bar",
            ]

            Gtk.Label tool_label {
              hexpand: true;
              ellipsize: end;
            }

            Gtk.Button {
              label: _("_Show Page");
              use-underline: true;
              action-name: "app.tool-show-page";
              valign: center;
            }

            Gtk.Button {
              label: _("_Stop");
              use-underline: true;
              action-name: "app.tool-stop";
              valign: center;
            }
          };
        }

        // New versions of Jewelcase, Soloist or soloistd (updates.rs).
        [top]
        Adw.Banner update_banner {
          button-label: _("_Details…");
          action-name: "app.show-update";
          revealed: false;
        }

        [top]
        Adw.Banner cd_banner {
          title: _("Audio CD detected");
          button-label: _("_Import");
          action-name: "app.import-cd";
          revealed: false;
        }

        [top]
        Adw.Banner unfinished_banner {
          button-label: _("_Continue");
          action-name: "app.continue-import";
          revealed: false;
        }

        // Smart shuffle's song analysis, asked once (CONCEPT.md §7).

        [top]
        Gtk.Revealer analysis_revealer {
          transition-type: slide_down;

          child: Adw.WrapBox {
            child-spacing: 6;
            line-spacing: 6;
            justify: fill;

            styles [
              "tool-bar",
            ]

            Gtk.Label analysis_label {
              hexpand: true;
              wrap: true;
              max-width-chars: 60;
              xalign: 0;
              valign: center;
            }

            Gtk.Box {
              spacing: 6;
              halign: end;

              Gtk.Button {
                label: _("_Not Now");
                use-underline: true;
                valign: center;
                action-name: "win.analysis-choice";
                action-target: "'off'";
              }

              Gtk.Button {
                label: _("In _Background");
                use-underline: true;
                valign: center;
                action-name: "win.analysis-choice";
                action-target: "'background'";
              }

              Gtk.Button {
                label: _("_Analyze Now");
                use-underline: true;
                valign: center;
                action-name: "win.analysis-choice";
                action-target: "'full'";

                styles [
                  "suggested-action",
                ]
              }
            }
          };
        }

        // The library views; search results float over them (§4.1).
        content: Gtk.Overlay library_overlay {
          child: Adw.ViewStack stack {
            Adw.ViewStackPage {
              name: "albums";
              title: _("Albums");
              icon-name: "media-optical-symbolic";

              child: Gtk.Stack albums_stack {
                transition-type: crossfade;

                Gtk.StackPage {
                  name: "empty";

                  child: Adw.StatusPage {
                    icon-name: "folder-music-symbolic";
                    title: _("No Albums Yet");
                    description: _("Jewelcase shows the albums in your music folders.");

                    child: Gtk.Button {
                      halign: center;
                      label: _("_Choose Music Folders…");
                      use-underline: true;
                      action-name: "app.preferences";

                      styles [
                        "pill",
                      ]
                    };
                  };
                }

                Gtk.StackPage {
                  name: "scanning";

                  child: Adw.StatusPage {
                    title: _("Looking for Music…");
                    description: _("Albums show up here as soon as they're found.");

                    child: Adw.Spinner {
                      height-request: 48;
                      width-request: 48;
                    };
                  };
                }

                Gtk.StackPage {
                  name: "albums";

                  child: $JewelcaseSlideView split_view {
                    show-sidebar: false;
                    min-sidebar-width: 320;
                    max-sidebar-width: 440;
                    sidebar-width-fraction: 0.38;
                    // The albums, and at the end, apart, saved Spotify
                    // albums (CONCEPT.md §9.8).
                    content: $JewelcaseSectionedGrid album_grid {};

                    sidebar: $JewelcaseAlbumPanel album_panel {};
                  };
                }
              };
            }

            Adw.ViewStackPage {
              name: "artists";
              title: _("Artists");
              icon-name: "avatar-default-symbolic";
              // Artist pages open over most of the grid (CONCEPT.md §4.2).
              child: $JewelcaseSlideView artist_split {
                collapsed: true;
                show-sidebar: false;
                min-sidebar-width: 360;
                max-sidebar-width: 968;

                styles [
                  "artist-overlay",
                ]

                sidebar: Adw.Bin artist_holder {};

                content: Gtk.Stack artists_stack {
                  transition-type: crossfade;

                  Gtk.StackPage {
                    name: "ask";

                    child: Adw.StatusPage {
                      icon-name: "avatar-default-symbolic";
                      title: _("Show Artist Photos and Links?");
                      description: _(
                        "Jewelcase can look up artists online: MusicBrainz identifies them; Wikidata, Wikipedia and Wikimedia Commons add links, a short biography and a photo; Deezer, and Spotify when it's connected, add photos. Only artist names, album titles and the artists' IDs are sent. You can change this any time in Preferences."
                      );

                      child: Gtk.Box {
                        halign: center;
                        spacing: 12;

                        Gtk.Button {
                          label: _("_Not Now");
                          use-underline: true;
                          action-name: "win.online-metadata";
                          action-target: "false";

                          styles [
                            "pill",
                          ]
                        }

                        Gtk.Button {
                          label: _("_Look Up Artists");
                          use-underline: true;
                          action-name: "win.online-metadata";
                          action-target: "true";

                          styles [
                            "pill",
                            "suggested-action",
                          ]
                        }
                      };
                    };
                  }

                  Gtk.StackPage {
                    name: "empty";

                    child: Adw.StatusPage {
                      icon-name: "avatar-default-symbolic";
                      title: _("No Artists Yet");
                      description: _("Album artists from your library will show up here.");
                    };
                  }

                  Gtk.StackPage {
                    name: "artists";
                    // The artists, and at the end, apart, followed
                    // Spotify artists (§9.8).
                    child: $JewelcaseSectionedGrid artist_grid {};
                  }
                };
              };
            }

            Adw.ViewStackPage {
              name: "playlists";
              title: _("Playlists");
              icon-name: "view-list-bullet-symbolic";

              child: Gtk.Stack playlists_stack {
                transition-type: crossfade;

                Gtk.StackPage {
                  name: "empty";

                  child: Adw.StatusPage {
                    icon-name: "view-list-bullet-symbolic";
                    title: _("No Playlists Yet");
                    description: _("Create a playlist, or import an M3U or XSPF file.");

                    child: Gtk.Box {
                      halign: center;
                      spacing: 12;

                      Gtk.Button {
                        label: _("_Import…");
                        use-underline: true;
                        action-name: "win.import-playlist";

                        styles [
                          "pill",
                        ]
                      }

                      Gtk.Button {
                        label: _("_New Playlist");
                        use-underline: true;
                        action-name: "win.new-playlist";

                        styles [
                          "pill",
                          "suggested-action",
                        ]
                      }
                    };
                  };
                }

                Gtk.StackPage {
                  name: "playlists";

                  child: $JewelcaseSlideView playlist_split {
                    show-sidebar: false;
                    min-sidebar-width: 320;
                    max-sidebar-width: 440;
                    sidebar-width-fraction: 0.38;

                    content: Gtk.ScrolledWindow {
                      hscrollbar-policy: never;

                      child: Gtk.Box {
                        orientation: vertical;

                        styles [
                          "album-grid",
                        ]

                        Gtk.FlowBox playlist_grid {
                          max-children-per-line: 40;
                          min-children-per-line: 2;
                          homogeneous: true;
                          selection-mode: none;
                          activate-on-single-click: true;
                          valign: start;

                          styles [
                            "playlist-flow",
                          ]
                        }

                        // Others' Spotify playlists: Spotify doesn't show
                        // their songs (CONCEPT.md §9.5).
                        Gtk.Button followed_toggle {
                          halign: start;
                          margin-start: 9;
                          margin-top: 18;
                          visible: false;

                          child: Adw.ButtonContent followed_content {
                            icon-name: "pan-end-symbolic";
                          };

                          styles [
                            "flat",
                            "heading",
                          ]
                        }

                        Gtk.Revealer followed_revealer {
                          transition-type: slide_down;

                          child: Gtk.FlowBox followed_grid {
                            max-children-per-line: 40;
                            min-children-per-line: 2;
                            homogeneous: true;
                            selection-mode: none;
                            activate-on-single-click: true;
                            valign: start;

                            styles [
                              "playlist-flow",
                            ]
                          };
                        }
                      };
                    };

                    sidebar: $JewelcasePlaylistPanel playlist_panel {};
                  };
                }
              };
            }
          };

          // Dims the view while searching; a click on it closes the search.

          [overlay]
          Gtk.Revealer search_dim {
            transition-type: crossfade;
            visible: false;

            child: Gtk.Box {
              styles [
                "search-dim",
              ]
            };
          }

          [overlay]
          Gtk.Revealer search_revealer {
            transition-type: crossfade;
            valign: start;
            visible: false;

            child: Adw.Clamp {
              maximum-size: 720;

              styles [
                "search-clamp",
              ]

              child: $JewelcaseSearchView search_view {
                styles [
                  "search-card",
                ]
              };
            };
          }
        };

        [bottom]
        Adw.ViewSwitcherBar switcher_bar {
          stack: stack;
        }
      };

      bottom-bar: $JewelcaseMiniPlayer mini_player {};

      sheet: $JewelcasePlayerView player_view {};
    };
  };
}

menu playlist_menu {
  section {
    item {
      label: _("_New Playlist…");
      action: "win.new-playlist";
    }

    item {
      label: _("_Import Playlist…");
      action: "win.import-playlist";
    }
  }
}

menu sort_menu {
  section {
    label: _("Sort By");

    item {
      label: _("_Artist");
      action: "win.album-sort";
      target: "artist";
    }

    item {
      label: _("_Title");
      action: "win.album-sort";
      target: "title";
    }

    item {
      label: _("_Year");
      action: "win.album-sort";
      target: "year";
    }

    item {
      label: _("Date _Added");
      action: "win.album-sort";
      target: "added";
    }
  }
}

menu artist_sort_menu {
  section {
    label: _("Sort By");

    item {
      label: _("_Name");
      action: "win.artist-sort";
      target: "name";
    }

    item {
      label: _("Date _Added");
      action: "win.artist-sort";
      target: "added";
    }
  }
}

menu primary_menu {
  section {
    item {
      label: _("_Import CD…");
      action: "app.import-cd";
    }

    item {
      label: _("_Rescan Library");
      action: "app.rescan";
    }
  }

  section {
    item {
      label: _("_Listening Statistics");
      action: "app.statistics";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Jewelcase");
      action: "app.about";
    }
  }
}
