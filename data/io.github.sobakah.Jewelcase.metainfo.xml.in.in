<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@app_id@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>

  <name>Jewelcase</name>
  <summary>Listen to albums, follow artists, curate playlists</summary>
  <description>
    <p>
      Jewelcase is a local-first music player for people who listen to albums.
      Cover art is the main way around your library, and lyrics, the queue
      and details stay out of the way until you want them.
    </p>
    <ul>
      <li>Albums, artists and playlists from your local music files</li>
      <li>A clean artist list with album artists only</li>
      <li>Synced lyrics with romanization</li>
      <li>Gapless playback, crossfade and smart shuffle</li>
      <li>Optional Spotify integration</li>
    </ul>
  </description>

  <developer id="io.github.sobakah">
    <name>sobakah</name>
  </developer>

  <url type="homepage">https://github.com/sobakah/jewelcase</url>
  <url type="bugtracker">https://github.com/sobakah/jewelcase/issues</url>
  <url type="vcs-browser">https://github.com/sobakah/jewelcase</url>

  <launchable type="desktop-id">@app_id@.desktop</launchable>
  <translation type="gettext">jewelcase</translation>
  <content_rating type="oars-1.1"/>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>

  <releases>
    <release version="0.6.1" date="2026-11-12" type="development">
      <description>
        <ul>
          <li>The app icon is as large as other apps' icons in the dock and the app grid</li>
          <li>The Spotify icon before songs from Spotify is the size of the other icons again, and the artist under such a song starts under the title</li>
        </ul>
      </description>
    </release>
    <release version="0.6.0" date="2026-11-12" type="development">
      <description>
        <ul>
          <li>New releases of the artists you follow on Spotify, under a bell in the header bar, read from Deezer once a day</li>
          <li>Artists can be sorted by name or date added; albums saved and artists followed on Spotify are sorted like your own</li>
          <li>A new app icon: a clear CD case with the disc inside</li>
          <li>The cover cache takes about half the space</li>
          <li>Playlist covers you choose are kept with your library data, so clearing the cache no longer loses them</li>
        </ul>
      </description>
    </release>
    <release version="0.5.1" date="2026-11-11" type="development">
      <description>
        <ul>
          <li>Editing tags works with cdport 1.0.0, and setting up cdport's and lyrembed's D-Bus services is offered again</li>
          <li>A small spinner while something loads from Spotify</li>
          <li>Shuffle and Repeat have tooltips that name the current mode</li>
          <li>The visualizer is off by default and moves more smoothly</li>
          <li>Tooltips appear after the usual short pause again</li>
        </ul>
      </description>
    </release>
    <release version="0.5.0" date="2026-11-11" type="development">
      <description>
        <p>A pre-release of Jewelcase, a music player for your album library with Spotify woven in.</p>
        <ul>
          <li>Albums grouped from your music files, with editions merged and covers as the main way around</li>
          <li>Artist pages with portraits, a short bio and links, from optional online lookups</li>
          <li>A player with synced lyrics and romanization, a visualizer, gapless playback, loudness levelling and smart crossfade</li>
          <li>Playlists, smart shuffle, listening statistics and one search for everything</li>
          <li>Lyrics, CD import and tag editing through lyrembed and cdport</li>
          <li>Optional Spotify integration: playlists both ways, saved albums, followed artists, Connect devices and streaming through Spotify Soloist</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
