<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@app_id@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>

  <name>Gatefold</name>
  <summary>Listen to albums, follow artists, curate playlists</summary>
  <description>
    <p>
      Gatefold is a local-first music player for people who listen to albums.
      Cover art is the main way around your library, and lyrics, the queue
      and details stay out of the way until you want them.
    </p>
    <ul>
      <li>Albums, artists and playlists from your local music files</li>
      <li>A clean artist list with album artists only</li>
      <li>Synced lyrics with romanization</li>
      <li>Gapless playback, crossfade and smart shuffle</li>
      <li>Optional Spotify integration</li>
    </ul>
  </description>

  <developer id="io.github.sobakah">
    <name>sobakah</name>
  </developer>

  <url type="homepage">https://github.com/sobakah/gatefold</url>
  <url type="bugtracker">https://github.com/sobakah/gatefold/issues</url>
  <url type="vcs-browser">https://github.com/sobakah/gatefold</url>

  <launchable type="desktop-id">@app_id@.desktop</launchable>
  <translation type="gettext">gatefold</translation>
  <content_rating type="oars-1.1"/>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>

  <releases>
    <release version="0.2.2" date="2026-11-08" type="development">
      <description>
        <p>Listening statistics, a visualizer and update notices.</p>
        <ul>
          <li>Listening Statistics: what played most this week, month, year or ever, with listening time and how it changed</li>
          <li>A visualizer moves with songs from your library, in the player and the mini player</li>
          <li>New versions of Gatefold, Soloist and soloistd are announced and installed when you choose to</li>
          <li>Next in the Spotify app skips to Gatefold's next song while Soloist plays</li>
          <li>The Pre-Amp setting is gone: local and Spotify songs play equally loud</li>
        </ul>
      </description>
    </release>
    <release version="0.2.1" date="2026-11-08" type="development">
      <description>
        <p>Recently played Spotify songs, and adding the playing song to playlists.</p>
        <ul>
          <li>Recently Played has the Spotify songs that played in Gatefold, with a menu to queue them again or add them to a playlist</li>
          <li>Add the playing song to a playlist from the player or the queue</li>
          <li>Playlists that have a song come first in "Add to Playlist"; choosing one again removes it</li>
          <li>Song Info lists the playlists that have the song</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2026-11-08" type="development">
      <description>
        <p>Spotify playlists you can fully edit, a new search, and lyrics for Spotify songs.</p>
        <ul>
          <li>Reorder, rename, give a cover to, delete or unfollow Spotify playlists</li>
          <li>Changes to Spotify playlists are sent more safely</li>
          <li>Search results by kind, with Spotify's results and an icon for what's in your library; recent searches</li>
          <li>Lyrics for Spotify songs from LRCLIB, and romanization for lyrics without it (with lyrembed 1.1.1)</li>
          <li>Songs chosen in the Spotify app keep playing on Soloist</li>
          <li>Renamed music folders keep their songs' play history</li>
          <li>Smart shuffle mixes in related artists from ListenBrainz</li>
          <li>Artist pages can be resized</li>
        </ul>
      </description>
    </release>
    <release version="0.1.1" date="2026-11-08" type="development">
      <description>
        <p>Playlists, Spotify fixes and a new look for the side panels.</p>
        <ul>
          <li>Playlists can be sorted by title, artist, album, date added or duration, also reversed</li>
          <li>Playlist songs can be queued, added to other playlists and lead to their album and artist</li>
          <li>The artist and album of Spotify songs in the player open their pages</li>
          <li>Choose the view to start with, and whether lyrics and queue show in the player</li>
          <li>Side panels show their cover blurred behind the top and close with a grip</li>
          <li>Artist photos from Spotify and Deezer; fanart.tv is no longer used</li>
          <li>Spotify search works again, and Gatefold respects Spotify's rate limits</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-11-07" type="development">
      <description>
        <p>The first pre-release of Gatefold.</p>
        <ul>
          <li>Albums grouped from your music files, with editions merged and covers as the main way around</li>
          <li>Artist pages with portraits, a short bio and links, from optional online lookups</li>
          <li>A player with synced lyrics and romanization, gapless playback, loudness levelling and smart crossfade</li>
          <li>Playlists with M3U8 and XSPF import and export, and one search for everything</li>
          <li>Smart shuffle that mixes in similar songs by genre, tempo, artist or sound</li>
          <li>Lyrics, CD import and tag editing through lyrembed, cdimport and Ear Tag</li>
          <li>Optional Spotify integration: Connect devices, playlists, saved albums, followed artists and streaming through Spotify Soloist</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
