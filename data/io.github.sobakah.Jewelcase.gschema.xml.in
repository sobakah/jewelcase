<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="jewelcase">
  <schema id="@app_id@" path="@schema_path@">
    <key name="window-width" type="i">
      <default>1100</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>760</default>
      <summary>Window height</summary>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
      <summary>Window is maximized</summary>
    </key>
    <key name="library-view" type="s">
      <choices>
        <choice value="albums"/>
        <choice value="artists"/>
        <choice value="playlists"/>
      </choices>
      <default>"albums"</default>
      <summary>Last library view</summary>
    </key>
    <key name="start-view" type="s">
      <choices>
        <choice value="last"/>
        <choice value="albums"/>
        <choice value="artists"/>
        <choice value="playlists"/>
      </choices>
      <default>"last"</default>
      <summary>View at start</summary>
      <description>The library view Jewelcase opens with; “last” is the one used last.</description>
    </key>
    <key name="style" type="s">
      <choices>
        <choice value="follow"/>
        <choice value="light"/>
        <choice value="dark"/>
      </choices>
      <default>"follow"</default>
      <summary>Light or dark style</summary>
      <description>“follow” follows the desktop; where it doesn't tell (some desktops), a GTK theme whose name says dark makes Jewelcase dark too.</description>
    </key>
    <key name="tile-size" type="i">
      <range min="120" max="280"/>
      <default>160</default>
      <summary>Cover size in the grids</summary>
      <description>The width of a cover in the album, artist and playlist grids, in pixels. Covers keep it when the window or a panel changes width; the grids then fit more or fewer columns.</description>
    </key>
    <key name="playlist-sort" type="s">
      <choices>
        <choice value="custom"/>
        <choice value="title"/>
        <choice value="artist"/>
        <choice value="album"/>
        <choice value="added"/>
        <choice value="added-reversed"/>
        <choice value="duration"/>
      </choices>
      <default>"custom"</default>
      <summary>Default sort of Jewelcase's playlists</summary>
      <description>How the songs of a playlist made in Jewelcase are listed while no sort was chosen for it: “custom” is its own order; “added-reversed” the newest first.</description>
    </key>
    <key name="spotify-playlist-sort" type="s">
      <choices>
        <choice value="custom"/>
        <choice value="title"/>
        <choice value="artist"/>
        <choice value="album"/>
        <choice value="added"/>
        <choice value="added-reversed"/>
        <choice value="duration"/>
      </choices>
      <default>"custom"</default>
      <summary>Default sort of Spotify playlists</summary>
      <description>Like playlist-sort, for playlists from Spotify (“custom”: Spotify's order).</description>
    </key>
    <key name="lyrics-pane" type="s">
      <choices>
        <choice value="remember"/>
        <choice value="open"/>
        <choice value="closed"/>
      </choices>
      <default>"remember"</default>
      <summary>Lyrics pane at start</summary>
      <description>Whether the player opens with the lyrics showing; “remember” keeps it as it was left.</description>
    </key>
    <key name="queue-pane" type="s">
      <choices>
        <choice value="remember"/>
        <choice value="open"/>
        <choice value="closed"/>
      </choices>
      <default>"remember"</default>
      <summary>Queue pane at start</summary>
      <description>Whether the player opens with the queue showing; “remember” keeps it as it was left.</description>
    </key>
    <key name="lyrics-pane-open" type="b">
      <default>false</default>
      <summary>Lyrics pane was open</summary>
    </key>
    <key name="queue-pane-open" type="b">
      <default>false</default>
      <summary>Queue pane was open</summary>
    </key>
    <key name="library-folders" type="as">
      <default>[]</default>
      <summary>Music folders</summary>
      <description>Folders the library is read from. While this key is unset, the XDG Music folder is used.</description>
    </key>
    <key name="album-sort" type="s">
      <choices>
        <choice value="artist"/>
        <choice value="title"/>
        <choice value="year"/>
        <choice value="added"/>
      </choices>
      <default>"artist"</default>
      <summary>Album sort order</summary>
    </key>
    <key name="crossfade" type="i">
      <range min="0" max="12"/>
      <default>0</default>
      <summary>Crossfade (seconds)</summary>
      <description>Songs fade into each other this long; 0 plays them gaplessly. Only between files (not Spotify songs).</description>
    </key>
    <key name="crossfade-smart" type="b">
      <default>true</default>
      <summary>Smart crossfade</summary>
      <description>The fade starts where a song gets quiet and ends where it’s over, and the next song starts after its silence; uses the song analysis. Off, or for songs not analyzed: the last seconds fade.</description>
    </key>
    <key name="crossfade-albums" type="b">
      <default>false</default>
      <summary>Crossfade within albums</summary>
      <description>Off: songs of an album playing in order follow gaplessly.</description>
    </key>
    <key name="visualizer" type="b">
      <default>false</default>
      <summary>Visualizer</summary>
      <description>Bars that move with the music in the player and the mini player (local songs only; off while GNOME’s animations are off).</description>
    </key>
    <key name="jewel-cases" type="b">
      <default>false</default>
      <summary>Albums in jewel cases</summary>
      <description>Album covers in the grids are drawn in CD jewel cases. A hidden extra, with no switch in Preferences.</description>
    </key>
    <key name="check-updates" type="b">
      <default>true</default>
      <summary>Check for updates</summary>
      <description>When Jewelcase starts and twice a day: new Jewelcase releases (the RPM build), new Soloist builds and soloistd releases. Nothing is installed without asking.</description>
    </key>
    <key name="skipped-updates" type="as">
      <default>[]</default>
      <summary>Updates skipped</summary>
      <description>Updates the user chose to skip, e.g. “jewelcase:0.5.1” or “soloist:&lt;ETag&gt;”; not offered again.</description>
    </key>
    <key name="statistics-period" type="s">
      <choices>
        <choice value="week"/>
        <choice value="month"/>
        <choice value="year"/>
        <choice value="all"/>
      </choices>
      <default>"month"</default>
      <summary>Period shown in Listening Statistics</summary>
      <description>The last 7 days, 30 days, 12 months, or everything logged.</description>
    </key>
    <key name="listening-stats" type="b">
      <default>true</default>
      <summary>Keep listening statistics</summary>
      <description>Every song that really played (half of it, or 30 seconds) is logged on this computer for Listening Statistics; nothing is sent anywhere.</description>
    </key>
    <key name="replaygain" type="s">
      <choices>
        <choice value="off"/>
        <choice value="auto"/>
        <choice value="track"/>
        <choice value="album"/>
      </choices>
      <default>"auto"</default>
      <summary>ReplayGain mode</summary>
      <description>“auto” uses album gain when an album plays in order and track gain while shuffling.</description>
    </key>
    <key name="restore-queue" type="b">
      <default>true</default>
      <summary>Restore the queue on start</summary>
      <description>Reopen the last queue, paused at the last position.</description>
    </key>
    <key name="lyrics-layout" type="s">
      <choices>
        <choice value="original-top"/>
        <choice value="romanization-top"/>
        <choice value="original-only"/>
      </choices>
      <default>"original-top"</default>
      <summary>Dual-line lyrics layout</summary>
      <description>Which line of original and romanization is shown large, or the original only.</description>
    </key>
    <key name="online-metadata" type="b">
      <default>false</default>
      <summary>Look up artists online</summary>
      <description>Artist photos, links and short biographies from MusicBrainz, Wikidata, Wikipedia, Deezer and (when connected) Spotify. Asked on first use of the Artists view.</description>
    </key>
    <key name="online-metadata-asked" type="b">
      <default>false</default>
      <summary>Whether the user was asked about online lookups</summary>
    </key>
    <key name="metadata-wikidata" type="b">
      <default>true</default>
      <summary>Use Wikidata, Wikimedia Commons and Wikipedia</summary>
    </key>
    <key name="metadata-spotify" type="b">
      <default>true</default>
      <summary>Artist photos from Spotify</summary>
      <description>Used while Spotify is connected.</description>
    </key>
    <key name="metadata-deezer" type="b">
      <default>true</default>
      <summary>Artist photos from Deezer</summary>
    </key>
    <key name="recent-searches" type="as">
      <default>[]</default>
      <summary>Recent searches</summary>
      <description>The last five searches, newest first, shown when the search field is empty.</description>
    </key>
    <key name="lyrics-lrclib" type="b">
      <default>true</default>
      <summary>Lyrics for Spotify songs from LRCLIB</summary>
      <description>For songs that aren't in the library, while the lyrics are shown; with online lookups on.</description>
    </key>
    <key name="lyrembed-path" type="s">
      <default>""</default>
      <summary>lyrembed program</summary>
      <description>Empty: look in PATH and ~/.local/bin.</description>
    </key>
    <key name="cdport-path" type="s">
      <default>""</default>
      <summary>cdport program</summary>
      <description>Empty: look for cdport in PATH and ~/.local/bin. Not needed when cdport's D-Bus service is set up.</description>
    </key>
    <key name="tag-editor" type="s">
      <choices>
        <choice value="cdport"/>
        <choice value="auto"/>
        <choice value="eartag"/>
        <choice value="kid3"/>
        <choice value="picard"/>
        <choice value="custom"/>
      </choices>
      <default>"cdport"</default>
      <summary>Tag editor</summary>
      <description>“cdport”: cdport’s own tag editor, in the browser. “auto”, an old value, counts as “cdport”. A Flatpak always uses cdport’s.</description>
    </key>
    <key name="tag-editor-command" type="s">
      <default>""</default>
      <summary>Custom tag editor command</summary>
      <description>With {files} for the files or {dir} for their folder.</description>
    </key>
    <!-- The keys under cdport's old name (cdimport): read once by tools.rs
         and carried over to the cdport keys. -->
    <key name="cdimport-path" type="s">
      <default>""</default>
      <summary>Deprecated: see cdport-path</summary>
    </key>
    <key name="cdimport-folder-offered" type="b">
      <default>false</default>
      <summary>Deprecated: see cdport-folder-offered</summary>
    </key>
    <key name="cdport-folder-offered" type="b">
      <default>false</default>
      <summary>Whether cdport’s library folder was offered as a music folder</summary>
    </key>
    <key name="artist-panel-width" type="i">
      <default>0</default>
      <summary>Width of artist pages</summary>
      <description>Set by dragging the page’s edge; 0: three quarters of the window.</description>
    </key>
    <key name="panel-width" type="i">
      <default>0</default>
      <summary>Width of the album and playlist panels</summary>
      <description>Set by dragging the panel’s edge; 0 sizes them automatically.</description>
    </key>
    <key name="spotify-links-in-app" type="b">
      <default>false</default>
      <summary>Open Spotify links in the Spotify app</summary>
      <description>Off: in the browser. The Spotify app starts playing what a link points to.</description>
    </key>
    <key name="spotify-client-id" type="s">
      <default>""</default>
      <summary>Spotify client ID</summary>
      <description>From the user’s own app at developer.spotify.com, with the redirect URI http://127.0.0.1:8974/callback.</description>
    </key>
    <key name="spotify-account" type="s">
      <default>""</default>
      <summary>Connected Spotify account</summary>
      <description>Its display name; empty when not connected. The login itself is in the keyring.</description>
    </key>
    <key name="spotify-streaming" type="b">
      <default>false</default>
      <summary>Stream from Spotify</summary>
      <description>Songs that aren’t in the library play from Spotify: through Spotify Soloist (official, installed separately; the default) or librespot (unofficial; only in builds with the spotify-stream feature), see spotify-stream-backend.</description>
    </key>
    <key name="spotify-stream-backend" type="s">
      <choices>
        <choice value="soloist"/>
        <choice value="librespot"/>
      </choices>
      <default>"soloist"</default>
      <summary>How Spotify songs stream</summary>
      <description>soloist: Spotify’s official Soloist (a running one, e.g. from soloistd, or started by Jewelcase). librespot: unofficial, only in builds with the spotify-stream feature.</description>
    </key>
    <key name="spotify-blocked" type="a{sx}">
      <default>{}</default>
      <summary>Spotify rate limits</summary>
      <description>Kinds of Spotify requests Spotify asked to stop for a long time, and until when (Unix seconds); not asked again before then, also after a restart.</description>
    </key>
    <key name="spotify-volume-offset" type="i">
      <range min="-15" max="6"/>
      <default>0</default>
      <summary>Volume of Spotify songs in Soloist (dB)</summary>
      <description>Spotify plays at about −14 LUFS, like files with ReplayGain; adjust to even them out.</description>
    </key>
    <key name="soloist-path" type="s">
      <default>""</default>
      <summary>Spotify Soloist program</summary>
      <description>Empty: look in PATH, ~/.local/bin and /usr/local/bin.</description>
    </key>
    <key name="show-spotify-albums" type="b">
      <default>false</default>
      <summary>Show saved Spotify albums</summary>
      <description>Albums saved on Spotify that aren’t in the library; a section at the end of the album grid.</description>
    </key>
    <key name="show-spotify-artists" type="b">
      <default>false</default>
      <summary>Show followed Spotify artists</summary>
      <description>Artists followed on Spotify that aren’t in the library; a section at the end of the artist grid.</description>
    </key>
    <key name="show-followed-playlists" type="b">
      <default>false</default>
      <summary>Show followed Spotify playlists</summary>
      <description>Others’ playlists, whose songs Spotify doesn’t show; at the end of the Playlists view.</description>
    </key>
    <key name="spotify-playlists" type="b">
      <default>true</default>
      <summary>Show Spotify playlists</summary>
      <description>The user’s Spotify playlists next to the local ones. Playlists published from Jewelcase stay linked either way.</description>
    </key>
    <key name="show-remaining-time" type="b">
      <default>false</default>
      <summary>Show the remaining time instead of the song’s length</summary>
    </key>
    <key name="analysis-mode" type="s">
      <choices>
        <choice value="off"/>
        <choice value="background"/>
        <choice value="full"/>
      </choices>
      <default>"off"</default>
      <summary>Song analysis for smart shuffle</summary>
      <description>“background”: one song at a time at low priority, waiting on battery; “full”: as fast as possible on several cores, then background for new songs.</description>
    </key>
    <key name="analysis-asked" type="b">
      <default>false</default>
      <summary>Whether the user was asked about song analysis</summary>
    </key>
    <key name="shuffle-albums" type="b">
      <default>false</default>
      <summary>Shuffle whole albums instead of songs</summary>
    </key>
    <key name="mix-similar" type="b">
      <default>false</default>
      <summary>Mix in similar songs</summary>
    </key>
    <key name="mix-genre" type="b">
      <default>true</default>
      <summary>Mix: same genre</summary>
    </key>
    <key name="mix-bpm" type="b">
      <default>false</default>
      <summary>Mix: similar tempo</summary>
    </key>
    <key name="mix-artist" type="b">
      <default>false</default>
      <summary>Mix: same artist</summary>
    </key>
    <key name="mix-sound" type="b">
      <default>true</default>
      <summary>Mix: sounds similar</summary>
    </key>
    <key name="mix-bpm-tolerance" type="i">
      <range min="2" max="25"/>
      <default>8</default>
      <summary>Mix: tempo tolerance in percent</summary>
    </key>
    <key name="mix-every" type="i">
      <range min="1" max="5"/>
      <default>3</default>
      <summary>Mix in one suggestion after this many songs</summary>
    </key>
    <key name="keep-playing-similar" type="b">
      <default>false</default>
      <summary>Keep playing similar music when the queue ends</summary>
    </key>
    <key name="mix-skip-recent-hours" type="i">
      <range min="0" max="168"/>
      <default>12</default>
      <summary>Don’t suggest songs played in the last hours</summary>
    </key>
    <key name="volume" type="d">
      <range min="0" max="1"/>
      <default>1</default>
      <summary>Playback volume</summary>
    </key>
  </schema>
</schemalist>
